{% comment %}
  ============================================================
  AK-FOOTER: Branded Back-to-Top launchpad
  Template-scoped — added only to 8 top-level page/collection JSONs.
  NOT global (footer.liquid and footer-group.json left untouched).
  Self-contained: all CSS + light JS inline. No canvas.
  ============================================================
{% endcomment %}

{%- style -%}
/* ===== AK-FOOTER: BACK TO TOP ===== */
.ak-footer{
  position:relative;
  width:100%;
  background:#000;
  padding:clamp(32px,4vh,56px) 0 clamp(20px,2.5vh,32px);
  margin-top:0; /* defend against global * {margin:0} stripping section spacing */
  display:flex;
  flex-direction:column;
  align-items:center;
  z-index:10;
}

/* divider */
.ak-footer-rule{
  display:block;
  width:min(1200px,92vw);
  height:1px;border:0;
  margin:0 auto clamp(24px,3vh,40px);
  background:linear-gradient(90deg,
    transparent 0%,
    rgba(255,255,255,.06) 20%,
    rgba(255,51,255,.10) 50%,
    rgba(255,255,255,.06) 80%,
    transparent 100%);
}

/* ---- text-only back-to-top button ---- */
.ak-btt{
  position:relative;
  display:inline-block;
  cursor:pointer;
  background:none;border:none;
  padding:8px 14px;
  -webkit-tap-highlight-color:transparent;
  outline:none;
  color:rgba(255,255,255,.58);
}
.ak-btt:focus-visible{
  outline:2px solid rgba(255,51,255,.5);
  outline-offset:4px;
  border-radius:6px;
}

.ak-btt-text{
  display:inline-block;
  font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;
  text-transform:uppercase;
  font-size:1.6rem;
  letter-spacing:0.14em;
  line-height:1;
  color:inherit;
  transition:color .22s ease;
}

/* ---- hover / focus state ---- */
.ak-btt:hover .ak-btt-text,
.ak-btt:focus-visible .ak-btt-text{
  color:#ff33ff;
}

/* ---- copyright ---- */
.ak-footer-copy{
  margin-top:clamp(20px,2.5vh,32px);
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  font-size:0.58rem;
  letter-spacing:0.06em;
  color:rgba(255,255,255,.14);
  line-height:1;
}

/* ---- responsive ---- */
@media(max-width:680px){
  .ak-btt-text{font-size:1.2rem;letter-spacing:0.14em}
}

/* ---- reduced motion ---- */
@media(prefers-reduced-motion:reduce){
  .ak-btt-text{transition:none !important}
}
{%- endstyle -%}

<footer class="ak-footer" role="contentinfo">
  <hr class="ak-footer-rule">

  <button class="ak-btt" id="AkBackToTop" type="button" aria-label="Back to top">
    <span class="ak-btt-text">CLICK HERE TO GET TOP</span>
  </button>

  <p class="ak-footer-copy">&copy; {{ 'now' | date: '%Y' }} AMERIKID</p>
</footer>

<script>
(function(){
  var btn = document.getElementById('AkBackToTop');
  if(!btn) return;

  var reduced = false;
  try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch(e){}

  btn.addEventListener('click', function(){
    /* scroll to top — target both viewport and body for pages
       where global CSS shifts the scroll container */
    var b = reduced ? 'auto' : 'smooth';
    window.scrollTo({ top: 0, behavior: b });
    document.body.scrollTop = 0;
    document.documentElement.scrollTop = 0;
  });
})();
</script>

{% schema %}
{
  "name": "AK Footer",
  "tag": "section",
  "class": "ak-footer-section",
  "settings": []
}
{% endschema %}
