{% comment %}
  ============================================================
  AK-FOOTER: Branded Back-to-Top launchpad
  Template-scoped — added only to 7 top-level page/collection JSONs.
  NOT global (footer.liquid and footer-group.json left untouched).
  Self-contained: all CSS + light JS inline. No canvas.
  ============================================================
{% endcomment %}

{%- style -%}
/* ===== AK-FOOTER: BACK TO TOP ===== */
.ak-footer{
  position:relative;
  width:100%;
  background:#000;
  padding:clamp(32px,4vh,56px) 0 clamp(20px,2.5vh,32px);
  margin-top:0; /* defend against global * {margin:0} stripping section spacing */
  display:flex;
  flex-direction:column;
  align-items:center;
  z-index:10;
}

/* divider */
.ak-footer-rule{
  display:block;
  width:min(1200px,92vw);
  height:1px;border:0;
  margin:0 auto clamp(24px,3vh,40px);
  background:linear-gradient(90deg,
    transparent 0%,
    rgba(255,255,255,.06) 20%,
    rgba(255,51,255,.10) 50%,
    rgba(255,255,255,.06) 80%,
    transparent 100%);
}

/* ---- launch button ---- */
.ak-btt{
  position:relative;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:0;
  cursor:pointer;
  background:none;border:none;padding:0;
  -webkit-tap-highlight-color:transparent;
  outline:none;
  color:#fff;
}
.ak-btt:focus-visible{
  outline:2px solid rgba(255,51,255,.5);
  outline-offset:8px;
  border-radius:12px;
}

/* outer ring — square with soft corners */
.ak-btt-ring{
  position:relative;
  width:64px;height:64px;
  border-radius:12px;
  border:1.5px solid rgba(255,255,255,.12);
  background:rgba(255,255,255,.02);
  display:flex;align-items:center;justify-content:center;
  transition:border-color .22s ease, background .22s ease, box-shadow .22s ease, transform .22s ease;
}

/* glow halo — hidden at rest, appears on hover */
.ak-btt-ring::before{
  content:"";
  position:absolute;inset:-8px;
  border-radius:16px;
  background:radial-gradient(circle,rgba(255,51,255,.12) 0%,transparent 70%);
  opacity:0;
  transition:opacity .28s ease;
  pointer-events:none;
}

/* chevron arrow */
.ak-btt-arrow{
  width:26px;height:26px;
  fill:none;stroke:rgba(255,255,255,.6);
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
  transition:stroke .22s ease, transform .22s ease;
}

/* BACK TO TOP text */
.ak-btt-label{
  margin-top:12px;
  font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;
  text-transform:uppercase;
  font-size:0.58rem;
  letter-spacing:0.22em;
  color:rgba(255,255,255,.28);
  line-height:1;
  transition:color .22s ease;
}

/* ---- hover state ---- */
.ak-btt:hover .ak-btt-ring{
  border-color:rgba(255,51,255,.35);
  background:rgba(255,51,255,.04);
  box-shadow:0 0 20px rgba(255,51,255,.12), 0 0 40px rgba(255,51,255,.06);
  transform:translateY(-3px);
}
.ak-btt:hover .ak-btt-ring::before{
  opacity:1;
}
.ak-btt:hover .ak-btt-arrow{
  stroke:#fff;
  transform:translateY(-2px);
}
.ak-btt:hover .ak-btt-label{
  color:rgba(255,255,255,.50);
}

/* ---- active/press state ---- */
.ak-btt:active .ak-btt-ring{
  transform:translateY(0) scale(0.94);
  transition:transform .06s ease;
}

/* ---- launch animation (triggered by JS class) ---- */
.ak-btt.is-launching .ak-btt-ring{
  animation:akBttPulse .5s ease-out;
}
.ak-btt.is-launching .ak-btt-arrow{
  animation:akBttLaunch .45s cubic-bezier(.16,1,.3,1) forwards;
}

@keyframes akBttPulse{
  0%{box-shadow:0 0 0 0 rgba(255,51,255,.28)}
  50%{box-shadow:0 0 0 18px rgba(255,51,255,.0)}
  100%{box-shadow:0 0 0 24px rgba(255,51,255,0)}
}
@keyframes akBttLaunch{
  0%{transform:translateY(0);opacity:1}
  50%{transform:translateY(-14px);opacity:.4}
  100%{transform:translateY(0);opacity:1}
}

/* ---- copyright ---- */
.ak-footer-copy{
  margin-top:clamp(20px,2.5vh,32px);
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  font-size:0.58rem;
  letter-spacing:0.06em;
  color:rgba(255,255,255,.14);
  line-height:1;
}

/* ---- responsive ---- */
@media(max-width:680px){
  .ak-btt-ring{width:56px;height:56px}
  .ak-btt-arrow{width:22px;height:22px}
  .ak-btt-label{font-size:0.52rem;margin-top:10px}
}

/* ---- reduced motion ---- */
@media(prefers-reduced-motion:reduce){
  .ak-btt-ring,
  .ak-btt-ring::before,
  .ak-btt-arrow,
  .ak-btt-label{
    transition:none !important;
  }
  .ak-btt:hover .ak-btt-ring{transform:none}
  .ak-btt:hover .ak-btt-arrow{transform:none}
  .ak-btt.is-launching .ak-btt-ring{animation:none}
  .ak-btt.is-launching .ak-btt-arrow{animation:none}
}
{%- endstyle -%}

<footer class="ak-footer" role="contentinfo">
  <hr class="ak-footer-rule">

  <button class="ak-btt" id="AkBackToTop" type="button" aria-label="Back to top">
    <span class="ak-btt-ring">
      <svg class="ak-btt-arrow" viewBox="0 0 24 24" aria-hidden="true">
        <polyline points="6 14 12 8 18 14"/>
      </svg>
    </span>
    <span class="ak-btt-label">Back to Top</span>
  </button>

  <p class="ak-footer-copy">&copy; {{ 'now' | date: '%Y' }} AMERIKID</p>
</footer>

<script>
(function(){
  var btn = document.getElementById('AkBackToTop');
  if(!btn) return;

  var reduced = false;
  try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch(e){}

  btn.addEventListener('click', function(){
    /* launch animation */
    btn.classList.add('is-launching');
    setTimeout(function(){ btn.classList.remove('is-launching'); }, 520);

    /* scroll to top — target both viewport and body for pages
       where global CSS shifts the scroll container */
    var b = reduced ? 'auto' : 'smooth';
    window.scrollTo({ top: 0, behavior: b });
    document.body.scrollTop = 0;
    document.documentElement.scrollTop = 0;
  });
})();
</script>

