/* ============================================================
   END PHASE 4.0 TIER 1
   ============================================================ */

/* ============================================================
   PHASE 5.0 — DOSSIER / EYES-ONLY FRAMING
   Additive cosmetic layer: envelope + corner brackets, watermark
   document bands, title rails, subtitle cartridge, plate memo
   tab + internal dividers, disclaimer signature ruling.
   No behavior, copy, or state changes. Purple #ff33ff only.
   ============================================================ */

/* --- Watermark document bands (top + bottom, classified feel) --- */
.ak-mb-prestart__watermark{
  position:absolute;
  left:32px;
  right:32px;
  z-index:1;
  pointer-events:none;
  overflow:hidden;
  white-space:nowrap;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  font-weight:700;
  font-size:14px;
  letter-spacing:0.5em;
  text-transform:uppercase;
  color:rgba(255,51,255,0.05);
  line-height:1;
  user-select:none;
  text-align:center;
}
.ak-mb-prestart__watermark--top{ top:32px; }
.ak-mb-prestart__watermark--bottom{ bottom:32px; }

/* --- Envelope framing: inset 1px magenta rule --- */
.ak-mb-prestart__envelope{
  position:absolute;
  inset:16px;
  z-index:2;
  pointer-events:none;
  border:1px solid rgba(255,51,255,0.16);
  box-shadow:
    inset 0 0 0 1px rgba(0,0,0,0.35),
    0 0 24px -8px rgba(255,51,255,0.14);
}

/* --- Envelope corner brackets (larger than shell-fx register marks) --- */
.ak-mb-prestart__env-corner{
  position:absolute;
  width:22px;
  height:22px;
  pointer-events:none;
}
.ak-mb-prestart__env-corner::before,
.ak-mb-prestart__env-corner::after{
  content:'';
  position:absolute;
  background:#ff33ff;
  box-shadow:0 0 6px rgba(255,51,255,0.45);
}
.ak-mb-prestart__env-corner::before{
  width:100%;
  height:2px;
}
.ak-mb-prestart__env-corner::after{
  width:2px;
  height:100%;
}
.ak-mb-prestart__env-corner--tl{ top:-2px; left:-2px; }
.ak-mb-prestart__env-corner--tl::before{ top:0; left:0; }
.ak-mb-prestart__env-corner--tl::after{ top:0; left:0; }
.ak-mb-prestart__env-corner--tr{ top:-2px; right:-2px; }
.ak-mb-prestart__env-corner--tr::before{ top:0; right:0; }
.ak-mb-prestart__env-corner--tr::after{ top:0; right:0; }
.ak-mb-prestart__env-corner--bl{ bottom:-2px; left:-2px; }
.ak-mb-prestart__env-corner--bl::before{ bottom:0; left:0; }
.ak-mb-prestart__env-corner--bl::after{ bottom:0; left:0; }
.ak-mb-prestart__env-corner--br{ bottom:-2px; right:-2px; }
.ak-mb-prestart__env-corner--br::before{ bottom:0; right:0; }
.ak-mb-prestart__env-corner--br::after{ bottom:0; right:0; }

/* --- Title rails: full-width magenta hairlines locking title --- */
.ak-mb-prestart__title-frame{
  position:relative;
  width:100%;
  max-width:560px;
  margin:0 auto;
  padding:14px 0 10px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.ak-mb-prestart__title-frame::before,
.ak-mb-prestart__title-frame::after{
  content:'';
  position:absolute;
  left:0;
  right:0;
  height:1px;
  background:linear-gradient(90deg,
    transparent 0%,
    rgba(255,51,255,0.35) 18%,
    rgba(255,51,255,0.55) 50%,
    rgba(255,51,255,0.35) 82%,
    transparent 100%);
  pointer-events:none;
}
.ak-mb-prestart__title-frame::before{ top:0; }
.ak-mb-prestart__title-frame::after{ bottom:0; }

/* --- Subtitle cartridge: bracket-wrap overrides Tier 1 inline bookends --- */
.ak-mb-prestart__subtitle{
  position:relative;
  padding:7px 30px 6px;
}
.ak-mb-prestart__subtitle::before,
.ak-mb-prestart__subtitle::after{
  content:'';
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  display:block;
  width:10px;
  height:calc(100% - 6px);
  background:transparent;
  border:1px solid rgba(255,51,255,0.72);
  box-shadow:0 0 6px rgba(255,51,255,0.3);
  box-sizing:border-box;
  margin:0;
  vertical-align:baseline;
}
.ak-mb-prestart__subtitle::before{
  left:8px;
  border-right:none;
}
.ak-mb-prestart__subtitle::after{
  right:8px;
  border-left:none;
}

/* --- Plate memo right tab (balances top-left label) --- */
.ak-mb-prestart__plate-tab-r{
  position:absolute;
  top:-7px;
  right:18px;
  padding:0 8px;
  background:#060504;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  font-size:10px;
  letter-spacing:0.3em;
  color:rgba(255,51,255,0.72);
  text-transform:uppercase;
  line-height:1;
  z-index:2;
  pointer-events:none;
  text-shadow:0 0 5px rgba(255,51,255,0.4);
}

/* --- Plate internal dashed dividers between brief lines --- */
.ak-mb-prestart__plate-body .ak-mb-prestart__brief-line:not(:last-child){
  padding-bottom:6px;
  border-bottom:1px dashed rgba(255,51,255,0.1);
}

/* --- Disclaimer signature ruling (fine repeating tick bg) --- */
.ak-mb-prestart__disclaimer{
  background:
    repeating-linear-gradient(90deg,
      transparent 0,
      transparent 6px,
      rgba(255,51,255,0.055) 6px,
      rgba(255,51,255,0.055) 7px),
    linear-gradient(180deg,#0a0908 0%,#060504 100%);
  border-top-color:rgba(255,51,255,0.28);
}

/* --- Responsive ≤640px --- */
@media (max-width:640px){
  .ak-mb-prestart__envelope{ inset:12px; }
  .ak-mb-prestart__env-corner{ width:18px; height:18px; }
  .ak-mb-prestart__watermark{
    left:22px;
    right:22px;
    font-size:11px;
    letter-spacing:0.45em;
  }
  .ak-mb-prestart__watermark--top{ top:22px; }
  .ak-mb-prestart__watermark--bottom{ bottom:22px; }
  .ak-mb-prestart__title-frame{
    max-width:420px;
    padding:11px 0 8px;
  }
  .ak-mb-prestart__subtitle{ padding:6px 24px 5px; }
  .ak-mb-prestart__subtitle::before{ left:6px; }
  .ak-mb-prestart__subtitle::after{ right:6px; }
  .ak-mb-prestart__plate-tab-r{ right:14px; font-size:9px; }
}

/* --- Responsive ≤380px --- */
@media (max-width:380px){
  .ak-mb-prestart__envelope{ inset:10px; }
  .ak-mb-prestart__env-corner{ width:14px; height:14px; }
  .ak-mb-prestart__watermark{
    left:16px;
    right:16px;
    font-size:9px;
    letter-spacing:0.4em;
  }
  .ak-mb-prestart__watermark--top{ top:16px; }
  .ak-mb-prestart__watermark--bottom{ bottom:16px; }
  .ak-mb-prestart__title-frame{
    max-width:300px;
    padding:9px 0 6px;
  }
  .ak-mb-prestart__subtitle{ padding:5px 20px 4px; }
  .ak-mb-prestart__subtitle::before{ left:5px; width:8px; }
  .ak-mb-prestart__subtitle::after{ right:5px; width:8px; }
  .ak-mb-prestart__plate-tab-r{ right:12px; font-size:8px; letter-spacing:0.26em; }
}
/* ============================================================
   END PHASE 5.0 — DOSSIER / EYES-ONLY FRAMING
   ============================================================ */

/* ----- Reduced motion ----- */
@media (prefers-reduced-motion:reduce){
  .ak-mb-prestart{
    animation:none;
    opacity:1;
    perspective:none;
  }
  .ak-mb-prestart::before{
    animation:none;
    opacity:0;
  }
  .ak-mb-prestart__inner{
    animation:none;
    opacity:1;
    transform:none !important;
    transform-style:flat;
  }
  .ak-mb-prestart__serial,
  .ak-mb-prestart__hero,
  .ak-mb-prestart__plate,
  .ak-mb-prestart__ctas,
  .ak-mb-prestart__disclaimer{
    animation:none !important;
    animation-delay:0s !important;
    opacity:1 !important;
    transform:none !important;
  }
  .ak-mb-prestart__vignette,
  .ak-mb-prestart__grain,
  .ak-mb-prestart__scanline{
    animation:none !important;
  }
  .ak-mb-prestart__title{
    animation:none !important;
  }
  .ak-mb-prestart__plate::after{
    animation:none !important;
    opacity:0.28;
  }
  .ak-mb-prestart__cta--primary::after{
    animation:none !important;
    opacity:0;
  }
  .ak-mb-prestart__serial-dot{
    animation:none;
    opacity:0.85;
  }
  /* Phase 4.0 Tier 1 — disclaimer bookend dot shares akMbPrestartPulse */
  .ak-mb-prestart__disclaimer::before{
    animation:none !important;
    opacity:0.85;
  }
  .ak-mb-prestart.is-dismissing{
    transition:none;
    opacity:0;
  }
  .ak-mb-prestart__cta{
    transition:none;
  }
  .ak-mb-prestart__cta--primary:hover,
  .ak-mb-prestart__cta--primary:active,
  .ak-mb-prestart__cta--secondary:hover,
  .ak-mb-prestart__cta--secondary:active{
    transform:none;
  }
  /* Phase 3.0 shell continuity — kill all ambient motion */
  .ak-mb-shell-fx__scanline,
  .ak-mb-shell-fx__grain,
  .ak-mb-shell-fx__hairline,
  .ak-mb-shell-fx__chin-cursor{
    animation:none !important;
  }
  .ak-mb-shell-fx__hairline{
    opacity:0.55;
  }
  .ak-mb-shell-fx__chin-cursor{
    opacity:1;
  }
  .ak-mb-frame::after{
    animation:none !important;
  }
}
/* ============================================================
   END AK-MB-PRESTART
   ============================================================ */
{%- endstyle -%}

<script>
(function(){
  /* ==========================================================
     AK MB PRE-START ORCHESTRATOR
     Shopify-side only. Does not edit the iframe or the embed.
     ========================================================== */

  /* Release gate timing — mirror sections/ak-mb-release.liquid.
     Pre-release: ak-mb-release owns the screen via #akMbLock,
     and this pre-start does NOT render. Post-release: pre-start
     owns the screen until START is clicked.
     2026-04-09T07:00:00Z = Thu Apr 9 2026, 12:00 AM America/Los_Angeles */
  var TARGET_UTC = Date.UTC(2026, 3, 9, 7, 0, 0);
  if (Date.now() < TARGET_UTC) return;

  var isPurchased = (function(){
    try {
      return new URLSearchParams(window.location.search).has('customer_id');
    } catch(e){ return false; }
  })();

  /* Phase 3.0 Shell Continuity — mounts a persistent atmospheric +
     telemetry layer inside .ak-mb-frame. Survives prestart dismiss.
     Returns the chin-text element so caller can swap wording when
     the overlay dismisses. */
  function initShellFx(frame, initialChinText){
    if (frame.dataset.akMbShellFxInit === '1') return null;
    frame.dataset.akMbShellFxInit = '1';

    var fx = document.createElement('div');
    fx.className = 'ak-mb-shell-fx';
    fx.setAttribute('aria-hidden', 'true');
    fx.innerHTML = [
      '<div class="ak-mb-shell-fx__scanline"></div>',
      '<div class="ak-mb-shell-fx__grain"></div>',
      '<div class="ak-mb-shell-fx__hairline"></div>',
      '<div class="ak-mb-shell-fx__reg ak-mb-shell-fx__reg--tl"></div>',
      '<div class="ak-mb-shell-fx__reg ak-mb-shell-fx__reg--tr"></div>',
      '<div class="ak-mb-shell-fx__reg ak-mb-shell-fx__reg--bl"></div>',
      '<div class="ak-mb-shell-fx__reg ak-mb-shell-fx__reg--br"></div>',
      '<div class="ak-mb-shell-fx__chin">',
        '<span class="ak-mb-shell-fx__chin-text">' + initialChinText + '</span>',
        '<span class="ak-mb-shell-fx__chin-cursor" aria-hidden="true"></span>',
      '</div>'
    ].join('');

    /* Insert as first child so DOM order follows stacking; z-index
       governs render order (shell-fx at 3, below prestart at 4). */
    frame.insertBefore(fx, frame.firstChild);
    return fx.querySelector('.ak-mb-shell-fx__chin-text');
  }

  function init(){
    var embed  = document.getElementById('ak-mysterybox-embed');
    var frame  = embed ? embed.querySelector('.ak-mb-frame') : null;
    var iframe = document.getElementById('akMbIframe');
    if (!embed || !frame || !iframe) return;

    /* Phase 3.0: mount shell continuity layer (idempotent, own guard) */
    var chinTextEl = initShellFx(
      frame,
      isPurchased ? 'CRATE // ACCESS GRANTED' : 'CRATE // LINK ACTIVE'
    );

    /* Single-init guard — do not double-mount */
    if (embed.dataset.akMbPrestartInit === '1') return;
    embed.dataset.akMbPrestartInit = '1';

    /* Build overlay DOM in one innerHTML pass (single reflow) */
    var overlay = document.createElement('div');
    overlay.className = 'ak-mb-prestart ak-mb-prestart--' + (isPurchased ? 'purchased' : 'public');
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-labelledby', 'akMbPrestartTitle');
    overlay.innerHTML = [
      '<div class="ak-mb-prestart__vignette" aria-hidden="true"></div>',
      '<div class="ak-mb-prestart__grain" aria-hidden="true"></div>',
      '<div class="ak-mb-prestart__scanline" aria-hidden="true"></div>',
      '<div class="ak-mb-prestart__watermark ak-mb-prestart__watermark--top" aria-hidden="true">CLASSIFIED // MYSTERY BOX // CLASSIFIED // MYSTERY BOX // CLASSIFIED // MYSTERY BOX // CLASSIFIED</div>',
      '<div class="ak-mb-prestart__watermark ak-mb-prestart__watermark--bottom" aria-hidden="true">EYES ONLY // SPIN PROTOCOL // EYES ONLY // SPIN PROTOCOL // EYES ONLY // SPIN PROTOCOL // EYES ONLY</div>',
      '<div class="ak-mb-prestart__envelope" aria-hidden="true">',
        '<span class="ak-mb-prestart__env-corner ak-mb-prestart__env-corner--tl"></span>',
        '<span class="ak-mb-prestart__env-corner ak-mb-prestart__env-corner--tr"></span>',
        '<span class="ak-mb-prestart__env-corner ak-mb-prestart__env-corner--bl"></span>',
        '<span class="ak-mb-prestart__env-corner ak-mb-prestart__env-corner--br"></span>',
      '</div>',
      '<div class="ak-mb-prestart__inner">',
        '<div class="ak-mb-prestart__serial">',
          '<span class="ak-mb-prestart__serial-dot" aria-hidden="true"></span>',
          '<span>CANDYFACTS</span>',
          '<span class="ak-mb-prestart__serial-sep">//</span>',
          '<span>LIVE</span>',
        '</div>',
        '<div class="ak-mb-prestart__hero">',
          '<div class="ak-mb-prestart__kicker">&mdash; AMERIKID &mdash;</div>',
          '<div class="ak-mb-prestart__title-frame">',
            '<h2 class="ak-mb-prestart__title" id="akMbPrestartTitle">MYSTERY BOX</h2>',
          '</div>',
          '<div class="ak-mb-prestart__subtitle">' + (isPurchased ? 'ENTER // ACCESS' : 'START // SPIN') + '</div>',
        '</div>',
        '<div class="ak-mb-prestart__plate">',
          '<div class="ak-mb-prestart__plate-label">' + (isPurchased ? 'YOUR ACCESS' : 'HOW IT WORKS') + '</div>',
          '<span class="ak-mb-prestart__plate-tab-r" aria-hidden="true">&middot; &middot; &middot;</span>',
          '<div class="ak-mb-prestart__plate-body">',
            isPurchased
              ? '<div class="ak-mb-prestart__brief-line">2 PURCHASED SPINS ARE READY.</div>' +
                '<div class="ak-mb-prestart__brief-line">PRESS ACCESS SPINS TO ENTER THE CRATE.</div>'
              : '<div class="ak-mb-prestart__brief-line">START HERE TO SPIN THE CRATE.</div>' +
                '<div class="ak-mb-prestart__brief-line">THE <a href="https://amerikid.ca/products/candyfacts-mystery-box-combo">COMBO PACK</a> INCLUDES 1 MYSTERY CRATE HAT + 1 CANDYFACTS SHIRT.</div>' +
                '<div class="ak-mb-prestart__brief-line">BUY THE COMBO PACK FIRST. ACCESS 2 SPINS THROUGH YOUR EMAIL CONFIRMATION LINK.</div>',
          '</div>',
        '</div>',
        '',
        '<div class="ak-mb-prestart__ctas">',
          isPurchased
            ? '<button type="button" class="ak-mb-prestart__cta ak-mb-prestart__cta--primary" id="akMbPrestartStart" aria-label="Access Spins — enter the crate with your purchased spins">' +
                '<span class="ak-mb-prestart__cta-label">ACCESS SPINS</span>' +
                '<span class="ak-mb-prestart__cta-sub">PURCHASED ACCESS</span>' +
              '</button>'
            : '<button type="button" class="ak-mb-prestart__cta ak-mb-prestart__cta--primary" id="akMbPrestartStart" aria-label="Start — spin the Mystery Box">' +
                '<span class="ak-mb-prestart__cta-label">START</span>' +
                '<span class="ak-mb-prestart__cta-sub">MYSTERY BOX</span>' +
              '</button>',
        '</div>',
        '<div class="ak-mb-prestart__disclaimer">',
          isPurchased
            ? 'PURCHASED ACCESS &middot; 2 SPINS &middot; NON-REFUNDABLE'
            : 'START HERE &middot; OR COMBO PACK &middot; 2 SPINS',
        '</div>',
      '</div>'
    ].join('');

    /* Mount as sibling of iframe and lock, inside .ak-mb-frame */
    frame.appendChild(overlay);

    /* Block iframe interaction while pre-start is active */
    iframe.style.pointerEvents = 'none';

    /* Wire START click → dismiss + restore iframe interaction */
    var startBtn = overlay.querySelector('#akMbPrestartStart');

    function dismiss(){
      if (overlay.classList.contains('is-dismissing')) return;
      overlay.classList.add('is-dismissing');
      window.setTimeout(function(){
        if (overlay && overlay.parentNode){
          overlay.parentNode.removeChild(overlay);
        }
        iframe.style.pointerEvents = 'auto';
        /* Phase 3.0: chin telemetry swaps to live wording post-dismiss */
        if (chinTextEl){
          chinTextEl.textContent = 'CRATE // ONLINE';
        }
      }, 200);
    }

    if (startBtn){
      startBtn.addEventListener('click', dismiss);
      /* Keyboard focus to Start for accessibility */
      try {
        startBtn.focus({ preventScroll: true });
      } catch(e){
        try { startBtn.focus(); } catch(e2){}
      }
    }
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "AK MB Pre-Start Screen",
  "tag": "section",
  "class": "ak-mb-prestart-section",
  "settings": []
}
{% endschema %}
