/* ============================================================
   PHASE 3.0 SHELL CONTINUITY
   Persistent atmospheric + telemetry layer inside .ak-mb-frame.
   Lives at z-index 3 (above iframe, below prestart overlay at 4,
   below lock at 5, below bevel/LED at 6). Survives prestart
   dismiss so bunker-monitor atmosphere continues across the
   iframe once the crate flow takes over.

   Scoped to elements mounted by this section's JS; overrides
   .ak-mb-frame::after (LED) by matching selector cascade. The
   iframe itself is never touched.
   ============================================================ */

.ak-mb-shell-fx{
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:3;
  overflow:hidden;
}

/* Scanline + grain insets match the frame's asymmetric padding
   (8/8/14/8 desktop) so they paint inside the screen area only,
   not over the bezel. */
.ak-mb-shell-fx__scanline,
.ak-mb-shell-fx__grain{
  position:absolute;
  top:8px;
  left:8px;
  right:8px;
  bottom:14px;
  pointer-events:none;
}
.ak-mb-shell-fx__scanline{
  background-image:repeating-linear-gradient(0deg,transparent 0px,transparent 3px,rgba(255,255,255,0.04) 3px,rgba(255,255,255,0.04) 4px);
  background-size:100% 160px;
  animation:akMbScanScroll 14s linear infinite;
  z-index:1;
}
.ak-mb-shell-fx__grain{
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  background-size:160px 160px;
  opacity:0.045;
  animation:akMbGrainDrift 18s linear infinite;
  z-index:1;
}

/* Top-edge phosphor hairline — faint magenta line just inside
   the top bezel, slow breathing pulse. */
.ak-mb-shell-fx__hairline{
  position:absolute;
  top:8px;
  left:8px;
  right:8px;
  height:1px;
  background:rgba(255,51,255,0.22);
  pointer-events:none;
  z-index:2;
  animation:akMbShellHair 7s ease-in-out infinite;
}

/* Corner register marks — tiny L-brackets in the four inner
   corners of the screen area. Purely presentational. */
.ak-mb-shell-fx__reg{
  position:absolute;
  width:8px;
  height:8px;
  pointer-events:none;
  opacity:0.42;
  z-index:2;
}
.ak-mb-shell-fx__reg::before,
.ak-mb-shell-fx__reg::after{
  content:'';
  position:absolute;
  background:rgba(255,51,255,0.55);
}
.ak-mb-shell-fx__reg::before{width:100%;height:1px;}
.ak-mb-shell-fx__reg::after{width:1px;height:100%;}
.ak-mb-shell-fx__reg--tl{top:11px;left:11px;}
.ak-mb-shell-fx__reg--tl::before{top:0;left:0;}
.ak-mb-shell-fx__reg--tl::after{top:0;left:0;}
.ak-mb-shell-fx__reg--tr{top:11px;right:11px;}
.ak-mb-shell-fx__reg--tr::before{top:0;right:0;}
.ak-mb-shell-fx__reg--tr::after{top:0;right:0;}
.ak-mb-shell-fx__reg--bl{bottom:17px;left:11px;}
.ak-mb-shell-fx__reg--bl::before{bottom:0;left:0;}
.ak-mb-shell-fx__reg--bl::after{bottom:0;left:0;}
.ak-mb-shell-fx__reg--br{bottom:17px;right:11px;}
.ak-mb-shell-fx__reg--br::before{bottom:0;right:0;}
.ak-mb-shell-fx__reg--br::after{bottom:0;right:0;}

/* Chin telemetry — mono-caps status strip + blinking cursor,
   sits in the chin area to the left of the centered LED. */
.ak-mb-shell-fx__chin{
  position:absolute;
  left:12px;
  bottom:3px;
  font-family:ui-monospace,Menlo,Consolas,monospace;
  font-size:8.5px;
  letter-spacing:0.22em;
  text-transform:uppercase;
  color:rgba(255,51,255,0.56);
  line-height:1;
  pointer-events:none;
  white-space:nowrap;
  user-select:none;
  z-index:2;
}
.ak-mb-shell-fx__chin-cursor{
  display:inline-block;
  width:6px;
  height:8px;
  margin-left:5px;
  vertical-align:-1px;
  background:rgba(255,51,255,0.62);
  animation:akMbChinCursor 1.1s steps(1) infinite;
}

/* LED life — override .ak-mb-frame::after with stacked
   breathing (opacity) + rare flicker (filter:brightness).
   Two animations target different properties so both apply
   without one losing to the other. Does not change LED color,
   size, or position. */
.ak-mb-frame::after{
  animation:akMbLedBreathe 5s ease-in-out infinite, akMbLedFlicker 27s linear infinite;
}

/* ----- Phase 3.0 keyframes ----- */
@keyframes akMbShellHair{
  0%,100%{opacity:0.55;}
  50%{opacity:1;}
}
@keyframes akMbLedBreathe{
  0%,100%{opacity:0.68;}
  50%{opacity:1;}
}
@keyframes akMbLedFlicker{
  0%,98.5%,100%{filter:brightness(1);}
  98.8%{filter:brightness(0.28);}
  99%{filter:brightness(1);}
  99.3%{filter:brightness(0.58);}
  99.5%{filter:brightness(1);}
}
@keyframes akMbChinCursor{
  0%,50%{opacity:1;}
  51%,100%{opacity:0;}
}

/* ----- Responsive: mobile (match frame padding 6/6/10/6) ----- */
@media (max-width:480px){
  .ak-mb-shell-fx__scanline,
  .ak-mb-shell-fx__grain{
    top:6px;
    left:6px;
    right:6px;
    bottom:10px;
  }
  .ak-mb-shell-fx__hairline{
    top:6px;
    left:6px;
    right:6px;
  }
  .ak-mb-shell-fx__reg{
    width:6px;
    height:6px;
  }
  .ak-mb-shell-fx__reg--tl{top:9px;left:9px;}
  .ak-mb-shell-fx__reg--tr{top:9px;right:9px;}
  .ak-mb-shell-fx__reg--bl{bottom:13px;left:9px;}
  .ak-mb-shell-fx__reg--br{bottom:13px;right:9px;}
  .ak-mb-shell-fx__chin{
    left:8px;
    bottom:2px;
    font-size:7.5px;
    letter-spacing:0.18em;
  }
  .ak-mb-shell-fx__chin-cursor{
    width:5px;
    height:7px;
    margin-left:4px;
  }
}

/* ============================================================
   PHASE 4.0 TIER 1 — HIERARCHY REFINEMENTS (2026-04-15)
   Pure CSS typographic/bookend/focus pass over existing prestart
   overlay. Zero DOM/JS changes. Zero behavior change. Scoped under
   .ak-mb-prestart. Respects existing palette (#ff33ff only).
   ============================================================ */

/* --- Kicker: stamp-plate authority (hairlines above/below) --- */
.ak-mb-prestart__kicker{
  padding:4px 14px 3px;
  border-top:1px solid rgba(255,51,255,0.22);
  border-bottom:1px solid rgba(255,51,255,0.10);
  color:rgba(232,228,219,0.62);
  letter-spacing:0.32em;
  font-size:10.5px;
}

/* --- Subtitle: leading/trailing magenta bookends --- */
.ak-mb-prestart__subtitle{
  transition:border-color 160ms ease-out,color 160ms ease-out;
}
.ak-mb-prestart__subtitle::before,
.ak-mb-prestart__subtitle::after{
  content:'';
  display:inline-block;
  width:4px;
  height:8px;
  background:#ff33ff;
  box-shadow:0 0 5px rgba(255,51,255,0.5);
  vertical-align:-1px;
}
.ak-mb-prestart__subtitle::before{margin-right:10px;}
.ak-mb-prestart__subtitle::after{margin-left:10px;}

/* --- Briefing hierarchy: imperative (1) → offer (2) → gate (3) --- */
.ak-mb-prestart__plate-body .ak-mb-prestart__brief-line:nth-child(1){
  font-size:14px;
  color:rgba(244,241,233,0.96);
  letter-spacing:0.04em;
  padding-bottom:2px;
}
.ak-mb-prestart__plate-body .ak-mb-prestart__brief-line:nth-child(1)::before{
  color:#ff33ff;
  text-shadow:0 0 6px rgba(255,51,255,0.6);
}
.ak-mb-prestart__plate-body .ak-mb-prestart__brief-line:nth-child(3){
  font-size:11px;
  color:rgba(232,228,219,0.6);
  letter-spacing:0.05em;
}
.ak-mb-prestart__plate-body .ak-mb-prestart__brief-line:nth-child(3)::before{
  color:rgba(255,51,255,0.55);
}

/* --- Disclaimer: console footer bookends (mirrors top serial) --- */
.ak-mb-prestart__disclaimer::before{
  content:'';
  position:absolute;
  left:14px;
  top:50%;
  transform:translateY(-50%);
  width:6px;
  height:6px;
  border-radius:50%;
  background:#ff33ff;
  box-shadow:
    0 0 5px rgba(255,51,255,0.6),
    inset 0 1px 1px rgba(255,255,255,0.25),
    inset 0 -1px 1px rgba(0,0,0,0.35),
    0 0 0 2px #040302;
  animation:akMbPrestartPulse 4s ease-in-out infinite;
}
.ak-mb-prestart__disclaimer::after{
  content:'';
  position:absolute;
  right:14px;
  top:50%;
  transform:translateY(-50%);
  width:4px;
  height:6px;
  background:rgba(255,51,255,0.5);
  box-shadow:0 0 4px rgba(255,51,255,0.35);
}

/* --- Focus echo: CTA focus coordinates panel accents via :has() --- */
.ak-mb-prestart__inner:has(.ak-mb-prestart__cta--primary:focus-visible) .ak-mb-prestart__plate::after{
  background:rgba(255,51,255,0.92);
}
.ak-mb-prestart__inner:has(.ak-mb-prestart__cta--primary:focus-visible) .ak-mb-prestart__subtitle{
  border-top-color:rgba(255,51,255,0.82);
  border-bottom-color:rgba(255,51,255,0.28);
  color:#ff66ff;
}

/* --- Responsive: tablet/phone --- */
