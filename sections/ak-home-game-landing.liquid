      "content": "Menu items (label + URL pairs)"
    },
    { "type": "text", "id": "link_1_label", "label": "Item 1 label", "default": "PRODUCTS" },
    { "type": "text", "id": "link_1_url",   "label": "Item 1 URL",   "default": "/collections/master-collection" },
