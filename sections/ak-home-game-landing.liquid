    { "type": "text", "id": "link_4_label", "label": "Item 4 label", "default": "LIFE/STYLE" },
    { "type": "text", "id": "link_4_url",   "label": "Item 4 URL",   "default": "/pages/the-collective" },
    { "type": "text", "id": "link_5_label", "label": "Item 5 label", "default": "NARRATIVE" },
