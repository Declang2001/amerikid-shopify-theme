{%- comment -%}
  ============================================================================
  ak-archive-magazine.liquid  —  "AmeriKid Archive Issue"
  ----------------------------------------------------------------------------
  A self-contained, sticker-like 3D magazine/comic flipbook that replaces the
  cassette deck on the /collections (list-collections) Archive page.

  - Self-contained: ALL HTML + CSS + JS inline. No external dep, no canvas,
    no WebGL, no new font (reuses ak-due-date.woff2 + ak-tenada.woff2 assets).
  - Progressive enhancement: the semantic `.ak-mag-source` block (masthead +
    contents + 18 real <a> item pages) is the no-JS fallback. JS adds
    `.is-enhanced`, hides the source, and composes a two-page (desktop) /
    single-page (mobile) flipbook by cloning page HTML into a book scaffold.
  - Reuses the existing notebook paper painted by snippets/ak-notebook-archive
    (rendered via custom_liquid_akArch1) — this section paints NOTHING on
    html/body and forces no global background; it only styles its own object.
  - Logo: reuses settings.logo (the same header/nav logo), never a hardcoded URL.

  REVERT (whole magazine): in templates/list-collections.json remove
  "ak-archive-magazine" from `order`, set "ak-archive" "disabled": false (or
  remove the "disabled" key) — the byte-frozen cassette deck returns identical.
  Then delete this file. sections/ak-archive.liquid is NEVER edited either way.
  ============================================================================
{%- endcomment -%}

{%- comment -%} ---- DATA: 18 archive items in locked source order (titles | urls | image files) ---- {%- endcomment -%}
{%- assign mag_titles = "Uh-Oh! Ghoul-Aid Tee|Bad Music Rock Tee|Kandy Hoodie|Uh-Oh! Tee|Election Tee|G.P.R. Tee|Kid Zyn|Liberty Bucket Hat|Aparikid|Love, Amerikid|Traveller Cap|Kat Skan Sleeveless|Stones Throw|Siwyc Collection|Solo Una|The Weed Tee|Watermelon Tee|The Skate Table" | split: "|" -%}
{%- assign mag_urls = "/collections/uh-oh-ghoul-aid-tee|/collections/bad-music|/collections/kandy|/collections/uh-oh-tee|/collections/2024-election-tee|/collections/gpr|/collections/kid-zyn|/collections/bucket|/collections/aperikid|/collections/love-amerikid|/collections/traveller-cap|/collections/kat-skan-tees|/collections/stones|/collections/say-it-with-your-chest-1|/collections/solo|/collections/weed|/collections/watermelon|/collections/skate-tables" | split: "|" -%}
{%- assign mag_imgs = "HW_UH-OH_Tee_Closeup.jpg|RICKY_BAD_2.jpg|DSCN0470.jpg|0willco_0willco-R1-011-4.jpg|Screenshot_2025-06-02_at_4.55.20_PM.jpg|A.kidxBusta_filmedited4.png|Flying-Zyns.jpg|MYSTIC420_HAT.heic|IMG_3722.heic|TREE_SQUAD.edited2.jpg|KiD_Flag_Patch.png|KAT_SKAN_CAMO.jpg|amerikid_x_ST_50_Shirts.jpg|SIWYC_Full_Collection.jpg|PURPLE_HAZE_EDIT.jpg|IMG_6998.jpg|watermelon_2.jpg|Screenshot_2025-06-13_at_7.13.25_PM.png" | split: "|" -%}
{%- assign mag_logo_alt = settings.logo.alt | default: shop.name -%}

<section
  class="ak-mag color-{{ section.settings.color_scheme }}"
  data-ak-mag
  aria-roledescription="magazine"
  aria-label="AmeriKid Archive Issue">

  {%- style -%}
    /* ===================== AK ARCHIVE MAGAZINE ===================== */
    @font-face{
      font-family:'AK Tenada';
      src:url('{{ 'ak-tenada.woff2' | asset_url }}') format('woff2');
      font-weight:normal;font-style:normal;font-display:swap;
      unicode-range:U+23; /* '#' only — must stay first in the stack */
    }
    @font-face{
      font-family:'AK Due Date';
      src:url('{{ 'ak-due-date.woff2' | asset_url }}') format('woff2');
      font-weight:normal;font-style:normal;font-display:swap;
    }

    .ak-mag{
      --paper:#f5dd4f;
      --ink:#15120b;
      --ink-mut:rgba(21,18,11,.5);
      --purple:#ff33ff;
      --page:#f6efe0;            /* light readable interior page */
      --page-2:#efe6d2;          /* page tint variant */
      --edge:#1a1714;            /* dark magazine edge */
      --turn:560ms;
      --display:'AK Tenada','AK Due Date',Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;
      position:relative;
      z-index:1;                 /* sit above the notebook doodle layer (z-index:0) */
      background:transparent;
      overflow-x:clip;
      padding:clamp(18px,4vw,52px) clamp(10px,3vw,40px) clamp(40px,7vw,96px);
      font-family:var(--display);
      color:var(--ink);
    }
    .ak-mag *,.ak-mag *::before,.ak-mag *::after{box-sizing:border-box;}

    .ak-mag-stage{
      display:flex;flex-direction:column;align-items:center;
    }

    /* ---------- NO-JS / SOURCE FALLBACK (also the data store) ---------- */
    .ak-mag-source{width:min(680px,94vw);margin:0 auto;}
    .ak-mag.is-enhanced .ak-mag-source{display:none;}
    .ak-mag-srcpage{
      background:var(--page);
      border:1px solid rgba(0,0,0,.12);
      border-radius:8px;
      box-shadow:6px 7px 0 rgba(0,0,0,.16);
      padding:clamp(18px,4vw,34px);
      margin:0 0 22px;
    }
    .ak-mag-source .ak-mag-item{display:block;text-decoration:none;color:inherit;}
    .ak-mag-source .ak-mag-cover{aspect-ratio:4/5;}

    /* ---------- BOOK SCAFFOLD (enhanced only) ---------- */
    .ak-mag-book{display:none;}
    .ak-mag.is-enhanced .ak-mag-book{
      display:block;position:relative;
      width:min(92vw,1040px);
      height:min(78vh,720px);
      margin-inline:auto;
      perspective:2200px;
      perspective-origin:50% 42%;
      touch-action:pan-y;
    }
    .ak-mag-book3d{
      position:absolute;inset:0;
      transform-style:preserve-3d;
      transform:rotateX(-1deg);
      transition:transform .38s cubic-bezier(.22,.68,.36,1.02);
      filter:drop-shadow(8px 10px 0 rgba(0,0,0,.20)) drop-shadow(0 22px 40px rgba(0,0,0,.28));
    }
    .ak-mag-book.is-jump .ak-mag-book3d{transition:opacity .14s ease;}
    .ak-mag-book.is-jump .ak-mag-spread{opacity:.55;}

    .ak-mag-spread{position:absolute;inset:0;display:flex;border-radius:6px;overflow:hidden;}
    .ak-mag-page{
      flex:1 1 50%;position:relative;overflow:hidden;
      background:var(--page);
      background-image:linear-gradient(180deg,rgba(255,255,255,.35),rgba(0,0,0,.04));
    }
    .ak-mag-pageL{border-radius:6px 0 0 6px;box-shadow:inset -14px 0 26px -16px rgba(0,0,0,.55);}
    .ak-mag-pageR{border-radius:0 6px 6px 0;box-shadow:inset 14px 0 26px -16px rgba(0,0,0,.55);}
    .ak-mag.is-enhanced .ak-mag-book.is-single .ak-mag-pageL{border-radius:6px;box-shadow:none;flex-basis:100%;}
    .ak-mag.is-enhanced .ak-mag-book.is-single .ak-mag-pageR{display:none;}

    /* dark fore-edge page stack on the outer sides + bottom */
    .ak-mag-spread::before,.ak-mag-spread::after{
      content:"";position:absolute;top:6px;bottom:6px;width:7px;z-index:1;pointer-events:none;
      background:repeating-linear-gradient(90deg,var(--edge) 0 1px,rgba(0,0,0,.18) 1px 2px,rgba(255,255,255,.12) 2px 3px);
      opacity:.9;
    }
    .ak-mag-spread::before{left:-7px;border-radius:3px 0 0 3px;}
    .ak-mag-spread::after{right:-7px;border-radius:0 3px 3px 0;}
    .ak-mag.is-enhanced .ak-mag-book.is-single .ak-mag-spread::before{display:none;}

    /* center spine / gutter */
    .ak-mag-spine{
      position:absolute;top:0;bottom:0;left:50%;width:46px;transform:translateX(-50%);
      z-index:4;pointer-events:none;
      background:linear-gradient(90deg,transparent,rgba(0,0,0,.26) 44%,rgba(0,0,0,.36) 50%,rgba(0,0,0,.26) 56%,transparent);
    }
    .ak-mag.is-enhanced .ak-mag-book.is-single .ak-mag-spine{display:none;}

    /* ---------- TURNING LEAF ---------- */
    .ak-mag-leaf{
      position:absolute;top:0;height:100%;width:50%;
      transform-style:preserve-3d;transform:rotateY(0deg);
      transition:transform var(--turn) cubic-bezier(.33,0,.2,1);
      z-index:6;display:none;will-change:transform;
    }
    .ak-mag.is-enhanced .ak-mag-leaf.is-right,
    .ak-mag.is-enhanced .ak-mag-leaf.is-left,
    .ak-mag.is-enhanced .ak-mag-leaf.is-full{display:block;}
    .ak-mag-leaf.is-right{left:50%;transform-origin:left center;}
    .ak-mag-leaf.is-left{left:0;transform-origin:right center;}
    .ak-mag-leaf.is-full{left:0;width:100%;}
    .ak-mag-leaf.is-full.to-next{transform-origin:left center;}
    .ak-mag-leaf.is-full.to-prev{transform-origin:right center;}
    .ak-mag-leaf.to-next.go{transform:rotateY(-180deg);}
    .ak-mag-leaf.to-prev.go{transform:rotateY(180deg);}

    .ak-mag-face{
      position:absolute;inset:0;overflow:hidden;
      backface-visibility:hidden;-webkit-backface-visibility:hidden;
      background:var(--page);
    }
    .ak-mag-face--front{transform:rotateY(0deg);z-index:2;}
    .ak-mag-face--back{transform:rotateY(180deg);z-index:1;}
    .ak-mag-leaf.is-right .ak-mag-face{border-radius:0 6px 6px 0;}
    .ak-mag-leaf.is-left .ak-mag-face{border-radius:6px 0 0 6px;}

    /* moving shadow cast during the turn */
    .ak-mag-shade{
      position:absolute;inset:0;z-index:3;pointer-events:none;opacity:0;
      background:linear-gradient(90deg,rgba(0,0,0,.42),rgba(0,0,0,0) 60%);
      mix-blend-mode:multiply;backface-visibility:hidden;
    }
    .ak-mag-leaf.is-left .ak-mag-shade{background:linear-gradient(270deg,rgba(0,0,0,.42),rgba(0,0,0,0) 60%);}
    .ak-mag-leaf.is-turning .ak-mag-shade{animation:akMagShade var(--turn) ease-in-out;}
    @keyframes akMagShade{0%{opacity:0}45%{opacity:.55}100%{opacity:0}}

    /* ---------- LO-FI IN-MOTION FX (turn only) ---------- */
    .ak-mag-fx{
      position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;
      mix-blend-mode:overlay;backface-visibility:hidden;
      background-image:
        url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>"),
        repeating-linear-gradient(0deg,transparent 0 2px,rgba(255,255,255,.10) 2px 3px);
      background-size:140px 140px,100% 4px;
    }
    .ak-mag-leaf.is-turning .ak-mag-fx{animation:akMagFx var(--turn) linear;}
    @keyframes akMagFx{
      0%{opacity:0}
      8%{opacity:.26}    /* glitch flicker spike */
      12%{opacity:.10}
      16%{opacity:.22}
      50%{opacity:.16}
      90%{opacity:.05}
      93%{opacity:0}
      100%{opacity:0}
    }
    /* chromatic aberration on the turning faces only */
    .ak-mag-leaf.is-turning .ak-mag-face{
      filter:drop-shadow(2px 0 0 rgba(255,51,255,.55)) drop-shadow(-2px 0 0 rgba(51,255,255,.5));
    }

    /* ---------- CONTROLS ---------- */
    .ak-mag-nav{
      display:flex;align-items:center;justify-content:center;gap:14px;
      margin:clamp(14px,2.4vw,26px) auto 0;
    }
    .ak-mag.is-enhanced ~ .x{}
    .ak-mag-btn{
      -webkit-appearance:none;appearance:none;cursor:pointer;
      width:48px;height:48px;border-radius:50%;
      display:inline-flex;align-items:center;justify-content:center;
      color:#fff;background:rgba(21,18,11,.62);
      border:1.5px solid rgba(21,18,11,.32);
      transition:background .15s ease,border-color .15s ease,transform .1s ease;
    }
    .ak-mag-btn:hover{background:rgba(21,18,11,.78);border-color:var(--purple);}
    .ak-mag-btn:active{transform:scale(.92);}
    .ak-mag-btn:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(255,51,255,.25);border-color:var(--purple);}
    .ak-mag-btn svg{width:20px;height:20px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round;}
    .ak-mag-counter{
      font-family:var(--display);font-size:.92rem;letter-spacing:.04em;text-transform:uppercase;
      color:var(--ink);min-width:9.5em;text-align:center;margin:0;
    }
    .ak-mag-nav,.ak-mag-corner{display:none;}
    .ak-mag.is-enhanced .ak-mag-nav{display:flex;}
    .ak-mag.is-enhanced .ak-mag-corner{display:block;}

    /* corner-curl cue (bottom-outer of the right page) */
    .ak-mag-corner{
      position:absolute;right:0;bottom:0;width:clamp(34px,3.4vw,52px);height:clamp(34px,3.4vw,52px);
      z-index:7;cursor:pointer;border:0;padding:0;background:transparent;
      -webkit-appearance:none;appearance:none;
    }
    .ak-mag-corner::before{
      content:"";position:absolute;inset:0;border-radius:0 0 6px 0;
      background:linear-gradient(135deg,transparent 46%,rgba(0,0,0,.12) 47%,rgba(255,255,255,.55) 60%,var(--page-2) 62%);
      box-shadow:-3px -3px 8px rgba(0,0,0,.18);
      transition:transform .18s ease;transform-origin:bottom right;
    }
    .ak-mag-corner:hover::before,.ak-mag-corner:focus-visible::before{transform:scale(1.18);}
    .ak-mag-corner:focus-visible{outline:none;}

    /* ---------- PAGE CONTENT (shared by source + faces + book pages) ---------- */
    .ak-mag-pad{position:absolute;inset:0;display:flex;flex-direction:column;padding:clamp(16px,2.4vw,30px);}
    .ak-mag-srcpage .ak-mag-pad{position:static;}

    .ak-mag-kicker{font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-mut);margin:0 0 .5em;}
    .ak-mag-logo{display:block;width:min(74%,260px);height:auto;margin:6px 0 18px;}
    .ak-mag-logo-fallback{font-family:var(--display);font-size:2rem;text-transform:uppercase;}
    .ak-mag-mast-title{font-family:var(--display);font-size:clamp(1.5rem,3.2vw,2.5rem);line-height:1;text-transform:uppercase;margin:0 0 .1em;letter-spacing:.01em;}
    .ak-mag-mast-issue{color:var(--purple);font-size:.96rem;letter-spacing:.18em;text-transform:uppercase;margin:0 0 1.1em;}
    .ak-mag-credits{list-style:none;margin:0;padding:0;display:grid;gap:.7em;}
    .ak-mag-credits li{line-height:1.2;}
    .ak-mag-credits b{display:block;font-size:1.02rem;letter-spacing:.01em;}
    .ak-mag-credits span{font-size:.82rem;color:var(--ink-mut);text-transform:uppercase;letter-spacing:.08em;}
    .ak-mag-colophon{margin-top:auto;font-size:.72rem;color:var(--ink-mut);letter-spacing:.06em;padding-top:1em;}

    .ak-mag-contents-h{font-family:var(--display);font-size:clamp(1.3rem,2.6vw,2rem);text-transform:uppercase;margin:0 0 .6em;}
    .ak-mag-toc{list-style:none;margin:0;padding:0;display:grid;gap:.18em;overflow:auto;}
    .ak-mag-toc li{display:flex;align-items:baseline;gap:.5em;border-bottom:1px dashed rgba(21,18,11,.22);padding:.34em 0;}
    .ak-mag-toc-num{font-variant-numeric:tabular-nums;color:var(--purple);font-size:.86rem;min-width:1.8em;}
    .ak-mag-toc-jump{flex:1;text-decoration:none;color:var(--ink);font-size:.96rem;line-height:1.15;}
    .ak-mag-toc-jump:hover{color:var(--purple);}
    .ak-mag-toc-jump:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(255,51,255,.25);border-radius:3px;}
    .ak-mag-toc-open{flex:none;text-decoration:none;color:var(--ink-mut);font-size:1rem;line-height:1;padding:0 .25em;border-radius:3px;}
    .ak-mag-toc-open:hover{color:var(--purple);}
    .ak-mag-toc-open:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(255,51,255,.25);}

    .ak-mag-item{display:block;text-decoration:none;color:var(--ink);height:100%;}
    .ak-mag-item:focus-visible{outline:none;box-shadow:inset 0 0 0 3px rgba(255,51,255,.3);}
    .ak-mag-cover{position:relative;flex:1;min-height:0;border-radius:4px;overflow:hidden;background:#1a1a1a;}
    .ak-mag-cover img{width:100%;height:100%;object-fit:cover;display:block;}
    .ak-mag-cover.is-missing img{display:none;}
    .ak-mag-cover.is-missing::after{
      content:attr(data-title);position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
      text-align:center;padding:1em;color:#fff;font-family:var(--display);text-transform:uppercase;
      font-size:1.1rem;background:linear-gradient(168deg,#1a1a1a,#0e0e0e 60%,#111);
    }
    .ak-mag-item-bar{display:flex;align-items:flex-end;justify-content:space-between;gap:.6em;padding-top:.7em;}
    .ak-mag-item-title{font-family:var(--display);font-size:clamp(1.05rem,2vw,1.5rem);line-height:1.05;text-transform:uppercase;margin:0;}
    .ak-mag-item-num{font-variant-numeric:tabular-nums;color:var(--purple);font-size:.9rem;}
    .ak-mag-item-cta{font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mut);margin:.3em 0 0;}

    /* ---------- MOBILE ---------- */
    @media (max-width:749px){
      .ak-mag{--turn:420ms;}
      .ak-mag.is-enhanced .ak-mag-book{width:min(94vw,460px);height:min(72vh,620px);perspective:1500px;}
      .ak-mag-btn{width:46px;height:46px;}
      .ak-mag-corner{width:42px;height:42px;}
    }
    @media (max-width:420px){
      .ak-mag.is-enhanced .ak-mag-book{height:min(70vh,560px);}
    }

    /* ---------- REDUCED MOTION ---------- */
    @media (prefers-reduced-motion: reduce){
      .ak-mag-book3d,.ak-mag-leaf{transition:none;}
      .ak-mag-leaf.is-turning .ak-mag-fx,
      .ak-mag-leaf.is-turning .ak-mag-shade{animation:none;}
      .ak-mag-fx{display:none;}
      .ak-mag-leaf.is-turning .ak-mag-face{filter:none;}
    }
  {%- endstyle -%}

  <div class="ak-mag-stage">

    {%- comment -%} ============ BOOK SCAFFOLD (filled + shown by JS) ============ {%- endcomment -%}
    <div class="ak-mag-book" data-book aria-hidden="true">
      <div class="ak-mag-book3d">
        <div class="ak-mag-spread">
          <div class="ak-mag-page ak-mag-pageL" data-pageL></div>
          <div class="ak-mag-page ak-mag-pageR" data-pageR></div>
        </div>
        <div class="ak-mag-spine"></div>
        <div class="ak-mag-leaf" data-leaf>
          <div class="ak-mag-face ak-mag-face--front" data-face-front></div>
          <div class="ak-mag-face ak-mag-face--back" data-face-back></div>
          <span class="ak-mag-shade"></span>
          <span class="ak-mag-fx"></span>
        </div>
        <button class="ak-mag-corner" type="button" data-next aria-label="Turn to next page"></button>
      </div>
    </div>

    {%- comment -%} ============ SOURCE / NO-JS FALLBACK (also the data store) ============ {%- endcomment -%}
    <div class="ak-mag-source" data-source>

      {%- comment -%} page 0 — MASTHEAD {%- endcomment -%}
      <article class="ak-mag-srcpage" data-srcpage data-label="Masthead" id="ak-mag-page-0">
        <div class="ak-mag-pad">
          <p class="ak-mag-kicker">Masthead</p>
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 600 | image_tag: class: 'ak-mag-logo', alt: mag_logo_alt, widths: '180,320,440,600', loading: 'lazy' }}
          {%- else -%}
            <span class="ak-mag-logo-fallback">{{ shop.name }}</span>
          {%- endif -%}
          <h2 class="ak-mag-mast-title">AmeriKid Archive Issue</h2>
          <p class="ak-mag-mast-issue">No. 01</p>
          <ul class="ak-mag-credits">
            <li><b>William Coleman</b><span>Creative Director</span></li>
            <li><b>Declan Gainey</b><span>Web Experience Designer &amp; Developer</span></li>
            <li><b>Cruz Centeno</b><span>Social Content Creative Lead</span></li>
            <li><b>Ricardo Garay</b><span>Community &amp; Social Outreach</span></li>
          </ul>
          <p class="ak-mag-colophon">AmeriKid — The Archive, in print.</p>
        </div>
      </article>

      {%- comment -%} page 1 — CONTENTS {%- endcomment -%}
      <nav class="ak-mag-srcpage" data-srcpage data-label="Contents" id="ak-mag-page-1" aria-label="Contents">
        <div class="ak-mag-pad">
          <p class="ak-mag-kicker">Contents</p>
          <h2 class="ak-mag-contents-h">Inside this issue</h2>
          <ol class="ak-mag-toc">
            {%- for title in mag_titles -%}
              {%- assign i = forloop.index0 -%}
              {%- assign pageId = i | plus: 2 -%}
              {%- assign num = forloop.index -%}
              <li>
                <span class="ak-mag-toc-num">{% if num < 10 %}0{% endif %}{{ num }}</span>
                <a class="ak-mag-toc-jump" href="#ak-mag-page-{{ pageId }}">{{ title }}</a>
                <a class="ak-mag-toc-open" href="{{ mag_urls[i] }}" aria-label="Open {{ title }} collection">&#8599;</a>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      </nav>

      {%- comment -%} pages 2..19 — 18 ITEM PAGES (real anchors to collections) {%- endcomment -%}
      {%- for title in mag_titles -%}
        {%- assign i = forloop.index0 -%}
        {%- assign pageId = i | plus: 2 -%}
        {%- assign num = forloop.index -%}
        {%- assign imgfile = mag_imgs[i] -%}
        <a class="ak-mag-srcpage ak-mag-item" data-srcpage data-label="{{ title | escape }}" id="ak-mag-page-{{ pageId }}" href="{{ mag_urls[i] }}">
          <div class="ak-mag-pad">
            <div class="ak-mag-cover" data-title="{{ title | escape }}">
              <img src="{{ imgfile | file_url }}" alt="{{ title | escape }}" loading="lazy" decoding="async"
                   onerror="this.closest('.ak-mag-cover').classList.add('is-missing');">
            </div>
            <div class="ak-mag-item-bar">
              <h2 class="ak-mag-item-title">{{ title }}</h2>
              <span class="ak-mag-item-num">{% if num < 10 %}0{% endif %}{{ num }}</span>
            </div>
            <p class="ak-mag-item-cta">Open collection &#8594;</p>
          </div>
        </a>
      {%- endfor -%}

    </div>

    {%- comment -%} ============ CONTROLS ============ {%- endcomment -%}
    <nav class="ak-mag-nav" aria-label="Magazine navigation">
      <button class="ak-mag-btn" type="button" data-prev aria-label="Previous page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <p class="ak-mag-counter" role="status" aria-live="polite">Spread 1</p>
      <button class="ak-mag-btn" type="button" data-next aria-label="Next page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </nav>

  </div>

  <script>
  (function(){
    var root = document.currentScript.closest('[data-ak-mag]') || document.querySelector('[data-ak-mag]');
    if(!root) return;
    var source = root.querySelector('[data-source]');
    var book   = root.querySelector('[data-book]');
    if(!source || !book) return;

    var srcPages = Array.prototype.slice.call(source.querySelectorAll('[data-srcpage]'));
    var META = srcPages.map(function(el){
      return { href: (el.tagName === 'A') ? el.getAttribute('href') : null, inner: el.innerHTML };
    });
    var N = META.length;
    if(N < 2) return;
    // build a book page's HTML, re-wrapping item pages in their real collection anchor
    function pageHTML(i){
      var m = META[i];
      if(!m) return '';
      return m.href ? ('<a class="ak-mag-item" href="' + m.href + '">' + m.inner + '</a>') : m.inner;
    }

    var book3d = book.querySelector('.ak-mag-book3d');
    var pageL  = book.querySelector('[data-pageL]');
    var pageR  = book.querySelector('[data-pageR]');
    var leaf   = book.querySelector('[data-leaf]');
    var faceF  = leaf.querySelector('[data-face-front]');
    var faceB  = leaf.querySelector('[data-face-back]');
    var counter = root.querySelector('.ak-mag-counter');
    var btnPrev = root.querySelectorAll('[data-prev]');
    var btnNext = root.querySelectorAll('[data-next]');

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var mqMobile = window.matchMedia('(max-width: 749px)');
    function isMobile(){ return mqMobile.matches; }

    var nSpreads = Math.ceil(N/2);
    var pos = 0;          // spread index (desktop) OR page index (mobile)
    var turning = false;
    var safetyT = null;
    var suppressClick = false;

    function totalViews(){ return isMobile() ? N : nSpreads; }
    function clamp(v,a,b){ return v<a?a:(v>b?b:v); }

    function bindJump(scope){
      var jumps = scope.querySelectorAll('.ak-mag-toc-jump');
      Array.prototype.forEach.call(jumps, function(a){
        if(a.__akBound) return; a.__akBound = true;
        a.addEventListener('click', function(e){
          var m = (a.getAttribute('href')||'').match(/ak-mag-page-(\d+)/);
          if(m){ e.preventDefault(); goToPage(parseInt(m[1],10)); }
        });
      });
    }

    function updateCounter(){
      if(!counter) return;
      counter.textContent = isMobile()
        ? ('Page ' + (pos+1) + ' of ' + N)
        : ('Spread ' + (pos+1) + ' of ' + totalViews());
    }

    function setStatic(){
      if(isMobile()){
        book.classList.add('is-single');
        pageL.innerHTML = pageHTML(pos);
        pageR.innerHTML = '';
      } else {
        book.classList.remove('is-single');
        var l = pos*2, r = pos*2+1;
        pageL.innerHTML = pageHTML(l);
        pageR.innerHTML = (r < N) ? pageHTML(r) : '';
      }
      bindJump(pageL); bindJump(pageR);
      updateCounter();
    }

    function focusView(){
      var t = pageL.querySelector('h1,h2') || pageL;
      if(t){ t.setAttribute('tabindex','-1'); try{ t.focus({preventScroll:true}); }catch(e){} }
    }

    function goToPage(pageIdx){
      var view = isMobile() ? pageIdx : Math.floor(pageIdx/2);
      goToView(view);
    }

    function goToView(view){
      view = clamp(view, 0, totalViews()-1);
      if(view === pos){ focusView(); return; }
      if(reduce.matches || Math.abs(view - pos) > 1){
        pos = view; setStatic();
        book.classList.add('is-jump');
        requestAnimationFrame(function(){ requestAnimationFrame(function(){ book.classList.remove('is-jump'); }); });
        focusView();
        return;
      }
      turn(view > pos ? 1 : -1);
    }

    function next(){ if(!turning && pos < totalViews()-1){ turn(1); } }
    function prev(){ if(!turning && pos > 0){ turn(-1); } }

    function turn(dir){
      if(turning) return;
      var to = clamp(pos + dir, 0, totalViews()-1);
      if(to === pos) return;

      if(reduce.matches){ pos = to; setStatic(); focusView(); return; }
      turning = true;

      leaf.className = 'ak-mag-leaf';
      if(dir > 0){
        // NEXT — flip right page (desktop) / current page (mobile) leftwards
        if(isMobile()){
          faceF.innerHTML = pageHTML(pos);
          faceB.innerHTML = pageHTML(to);
          pageL.innerHTML = pageHTML(to);
          leaf.classList.add('is-full','to-next');
        } else {
          faceF.innerHTML = pageHTML(pos*2+1);
          faceB.innerHTML = pageHTML(to*2);
          pageR.innerHTML = pageHTML(to*2+1);
          leaf.classList.add('is-right','to-next');
        }
      } else {
        // PREV — flip left page (desktop) / current page (mobile) rightwards
        if(isMobile()){
          faceF.innerHTML = pageHTML(pos);
          faceB.innerHTML = pageHTML(to);
          pageL.innerHTML = pageHTML(to);
          leaf.classList.add('is-full','to-prev');
        } else {
          faceF.innerHTML = pageHTML(pos*2);
          faceB.innerHTML = pageHTML(to*2+1);
          pageL.innerHTML = pageHTML(to*2);
          leaf.classList.add('is-left','to-prev');
        }
      }
      bindJump(faceF); bindJump(faceB); bindJump(pageL); bindJump(pageR);

      // start
      leaf.classList.add('is-turning');
      void leaf.offsetWidth;            // reflow so the rotate transition runs
      leaf.classList.add('go');

      clearTimeout(safetyT);
      safetyT = setTimeout(finish, 700);
      leaf.addEventListener('transitionend', onEnd);

      function onEnd(e){
        if(e.target !== leaf || e.propertyName !== 'transform') return;
        finish();
      }
      function finish(){
        if(!turning) return;
        leaf.removeEventListener('transitionend', onEnd);
        clearTimeout(safetyT);
        pos = to;
        setStatic();
        leaf.className = 'ak-mag-leaf';   // reset → display:none
        turning = false;
        focusView();
      }
    }

    /* ---- controls ---- */
    Array.prototype.forEach.call(btnPrev, function(b){ b.addEventListener('click', function(e){ e.preventDefault(); prev(); }); });
    Array.prototype.forEach.call(btnNext, function(b){ b.addEventListener('click', function(e){ e.preventDefault(); next(); }); });

    /* ---- keyboard (when focus is within the magazine) ---- */
    root.addEventListener('keydown', function(e){
      var k = e.key;
      if(k==='ArrowRight'||k==='ArrowDown'){ e.preventDefault(); next(); }
      else if(k==='ArrowLeft'||k==='ArrowUp'){ e.preventDefault(); prev(); }
      else if(k==='Home'){ e.preventDefault(); goToView(0); }
      else if(k==='End'){ e.preventDefault(); goToView(totalViews()-1); }
    });

    /* ---- drag / swipe (commit on release) ---- */
    var sx=0, sy=0, st=0, dragging=false;
    book.addEventListener('pointerdown', function(e){
      if(turning) return;
      sx=e.clientX; sy=e.clientY; st=Date.now(); dragging=true;
    });
    book.addEventListener('pointerup', function(e){
      if(!dragging) return; dragging=false;
      var dx=e.clientX-sx, dy=e.clientY-sy, dt=Date.now()-st;
      if(Math.abs(dx) < 8 || Math.abs(dx) < Math.abs(dy)) return;  // not a horizontal swipe → let clicks/links work
      var w = book.clientWidth || 1;
      var vel = Math.abs(dx)/(dt||1);
      if(Math.abs(dx) > w*0.18 || vel > 0.5){
        suppressClick = true;
        setTimeout(function(){ suppressClick=false; }, 360);
        if(dx < 0) next(); else prev();
      }
    });
    // stop a swipe from also activating a page link
    book.addEventListener('click', function(e){
      if(suppressClick){ e.preventDefault(); e.stopPropagation(); suppressClick=false; }
    }, true);

    /* ---- mode change (desktop <-> mobile): remap position to the same page ---- */
    function onModeChange(){
      var wasMobile = book.__wasMobile;
      var nowMobile = isMobile();
      if(wasMobile === nowMobile){ return; }
      // translate current position to a page, then to the new view unit
      var pageIdx;
      if(wasMobile === undefined){ pageIdx = 0; }
      else if(wasMobile){ pageIdx = pos; }            // was page index
      else { pageIdx = pos*2; }                       // was spread index → left page
      pos = nowMobile ? pageIdx : Math.floor(pageIdx/2);
      pos = clamp(pos, 0, totalViews()-1);
      book.__wasMobile = nowMobile;
      if(turning){ turning=false; clearTimeout(safetyT); }
      leaf.className = 'ak-mag-leaf';
      setStatic();
    }
    if(mqMobile.addEventListener){ mqMobile.addEventListener('change', onModeChange); }
    else if(mqMobile.addListener){ mqMobile.addListener(onModeChange); }

    /* ---- init ---- */
    root.classList.add('is-enhanced');
    source.setAttribute('hidden','');
    source.setAttribute('aria-hidden','true');
    book.removeAttribute('aria-hidden');
    book.__wasMobile = isMobile();
    setStatic();
  })();
  </script>

  {% schema %}
  {
    "name": "Archive Magazine",
    "tag": "section",
    "class": "ak-archive-magazine-section",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme-4",
        "label": "Color scheme"
      }
    ],
    "presets": [
      { "name": "Archive Magazine" }
    ]
  }
  {% endschema %}
</section>
