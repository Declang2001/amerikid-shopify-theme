<script>
(function(){
  'use strict';
  var N=18, VIS=6;
  /* v6 stack: bottom-aligned cards, upward fan via translateY only.
     No perspective/translateZ — the reference is a flat vertical fan. */
  var STRIP=26;     /* px of visible strip per trailing card */
  var SCALE_STEP=0.018; /* slight scale reduction per depth for narrowing */
  /* drag */
  var THRESH=40, VEL_THRESH=400;

  var cards=[].slice.call(document.querySelectorAll('.ak-archive-card'));
  var root=document.getElementById('AkArchive');
  var stage=document.getElementById('AkArchiveStage');
  var cur=0, anim=false, animSafetyTimer=null;

  /* Per-card spring cancellation — prevents orphaned springs */
  var springStops={};

  /* ---- spring helper ---- */
  function springTo(el,props,k,d,cb){
    var cardIdx=el.getAttribute('data-card');
    /* cancel any running spring on this card */
    if(cardIdx!==null && springStops[cardIdx]) springStops[cardIdx]();

    var keys=Object.keys(props);
    var vel={},pos={};
    keys.forEach(function(p){pos[p]=parseFloat(el._sp&&el._sp[p]||0);vel[p]=el._sv&&el._sv[p]||0;});
    el._sp=pos;el._sv=vel;
    var stiff=k||170,damp=d||22;
    var done=false;
    function stop(){done=true;}
    function tick(){
      if(done)return;
      var allDone=true;
      keys.forEach(function(p){
        var x=pos[p],v=vel[p],target=props[p];
        var spring=-stiff*(x-target);
        var damping=-damp*v;
        var a=spring+damping;
        v+=a*0.016;x+=v*0.016;
        if(Math.abs(x-target)<0.3&&Math.abs(v)<0.5){x=target;v=0;}
        else{allDone=false;}
        pos[p]=x;vel[p]=v;
      });
      el._sp=pos;el._sv=vel;
      applyTransform(el,pos);
      if(allDone){done=true;if(cardIdx!==null)springStops[cardIdx]=null;if(cb)cb();}
      else{requestAnimationFrame(tick);}
    }
    if(cardIdx!==null) springStops[cardIdx]=stop;
    requestAnimationFrame(tick);
    return stop;
  }

  function applyTransform(el,p){
    var ty=p.ty||0, sc=p.sc||1, rz=p.rz||0, op=p.op;
    el.style.transform='translateY('+ty.toFixed(1)+'px) scale('+sc.toFixed(4)+')'+
      (rz?(' rotateZ('+rz.toFixed(2)+'deg)'):'');
    if(op!==undefined)el.style.opacity=Math.max(0,Math.min(1,op)).toFixed(3);
  }

  /* ---- layout: bottom-aligned, upward fan ---- */
  function depthShadow(depth){
    if(depth===0) return '0 8px 40px rgba(0,0,0,0.65), 0 2px 6px rgba(0,0,0,0.35)';
    return '0 4px '+(12+depth*6)+'px rgba(0,0,0,'+(0.2+depth*0.06).toFixed(2)+')';
  }

  function setRestState(el,depth,instant){
    var target={
      ty: -depth*STRIP,
      sc: 1-depth*SCALE_STEP,
      rz: 0,
      op: depth===0?1:Math.max(0.55, 1-depth*0.08)
    };
    if(instant){
      el._sp=target;el._sv={ty:0,sc:0,rz:0,op:0};
      applyTransform(el,target);
    }else{
      springTo(el,target,200,24);
    }
  }

  function layout(skipFront,instant){
    for(var i=0;i<N;i++){
      var c=cards[i];
      var depth=(i-cur+N)%N;
      c.setAttribute('data-depth',depth<VIS?depth:'hidden');
      if(depth>=VIS){
        c.style.opacity='0';c.style.zIndex=0;
        c.setAttribute('data-active','false');
        c._sp=null;c._sv=null;
        continue;
      }
      c.setAttribute('data-active',depth===0?'true':'false');
      c.style.zIndex=N-depth;
      c.querySelector('.ak-archive-card-inner').style.boxShadow=depthShadow(depth);
      if(depth===0&&skipFront)continue;
      setRestState(c,depth,instant);
    }
  }

  /* ---- navigate ---- */
  function clearAnimSafety(){if(animSafetyTimer){clearTimeout(animSafetyTimer);animSafetyTimer=null;}}
  function startAnimSafety(){clearAnimSafety();animSafetyTimer=setTimeout(function(){anim=false;animSafetyTimer=null;},700);}

  function goNext(){
    if(anim)return;
    anim=true;startAnimSafety();
    var front=cards[cur];
    springTo(front,{ty:-400,sc:0.88,rz:-4,op:0},180,18,function(){
      front._sp=null;front._sv=null;
      cur=(cur+1)%N;
      layout(false,false);
      clearAnimSafety();anim=false;
    });
    /* pre-spring trailing cards toward new positions */
    for(var d=1;d<VIS;d++){
      var idx=(cur+d)%N;
      var c=cards[idx];
      var fd=d-1;
      c.style.zIndex=N-fd;
      c.setAttribute('data-active',fd===0?'true':'false');
      c.setAttribute('data-depth',fd);
      c.querySelector('.ak-archive-card-inner').style.boxShadow=depthShadow(fd);
      setRestState(c,fd,false);
    }
    /* bring next hidden card into back of stack */
    var backIdx=(cur+VIS)%N;
    var bc=cards[backIdx];
    bc.style.opacity='0';bc.style.zIndex=N-VIS+1;
    bc.setAttribute('data-depth',VIS-1);
    bc._sp={ty:-(VIS)*STRIP,sc:1-VIS*SCALE_STEP,rz:0,op:0};
    bc._sv={ty:0,sc:0,rz:0,op:0};
    applyTransform(bc,bc._sp);
    setRestState(bc,VIS-1,false);
  }

  function goPrev(){
    if(anim)return;
    anim=true;startAnimSafety();
    var front=cards[cur];
    springTo(front,{ty:300,sc:0.9,rz:3,op:0},180,18,function(){
      front._sp=null;front._sv=null;
      cur=(cur-1+N)%N;
      layout(false,false);
      clearAnimSafety();anim=false;
    });
    /* bring previous card in from above */
    var prev1=(cur-1+N)%N;
    var c=cards[prev1];
    c.style.zIndex=N;c.style.opacity='0';
    c.setAttribute('data-active','true');
    c.setAttribute('data-depth','0');
    c._sp={ty:-250,sc:0.92,rz:0,op:0};c._sv={ty:0,sc:0,rz:0,op:0};
    applyTransform(c,c._sp);
    springTo(c,{ty:0,sc:1,rz:0,op:1},200,24);
  }

  /* ---- controls: arrows always work, never blocked by drag state ---- */
  document.getElementById('AkNext').addEventListener('click',function(e){
    e.preventDefault();e.stopPropagation();goNext();
  });
  document.getElementById('AkPrev').addEventListener('click',function(e){
    e.preventDefault();e.stopPropagation();goPrev();
  });

  /* ---- drag + click: clean separation ---- */
  var dragging=false,dragCard=null;
  var startX=0,startY=0,dy=0,lastTime=0,velocity=0,pointerId=null;
  var didMove=false; /* true if pointer moved beyond tap threshold */

  function resetDrag(){
    dragging=false;dragCard=null;pointerId=null;
    dy=0;velocity=0;didMove=false;
  }

  stage.addEventListener('pointerdown',function(e){
    if(anim||dragging)return;
    /* only on active front card */
    var el=e.target.closest?e.target.closest('.ak-archive-card'):null;
    if(!el||el.getAttribute('data-active')!=='true')return;
    /* ignore buttons */
    if(e.target.closest&&e.target.closest('button'))return;

    dragging=true;didMove=false;
    dragCard=el;pointerId=e.pointerId;
    startX=e.clientX;startY=e.clientY;
    dy=0;velocity=0;lastTime=Date.now();
    /* seed spring state at rest */
    dragCard._sp={ty:0,sc:1,rz:0,op:1};
    dragCard._sv={ty:0,sc:0,rz:0,op:0};
    /* capture on stage so we get move/up even if pointer leaves */
    try{stage.setPointerCapture(e.pointerId);}catch(ex){}
    e.preventDefault(); /* prevent text selection / native drag */
  });

  stage.addEventListener('pointermove',function(e){
    if(!dragging||!dragCard||e.pointerId!==pointerId)return;
    var now=Date.now();
    var dt=Math.max(1,now-lastTime);
    var newDy=e.clientY-startY;
    if(!didMove&&(Math.abs(e.clientX-startX)+Math.abs(e.clientY-startY))>5) didMove=true;
    velocity=(newDy-dy)/dt*1000;
    dy=newDy;lastTime=now;
    var rot=dy*-0.03;
    var sc=1-Math.abs(dy)*0.0003;
    var op=1-Math.abs(dy)/600;
    dragCard.style.transform='translateY('+dy+'px) scale('+Math.max(0.85,sc).toFixed(4)+') rotateZ('+rot.toFixed(2)+'deg)';
    dragCard.style.opacity=Math.max(0.15,op).toFixed(3);
  });

  function finishDrag(e){
    if(!dragging||!dragCard||e.pointerId!==pointerId)return;
    try{stage.releasePointerCapture(e.pointerId);}catch(ex){}
    var card=dragCard, localDy=dy, localVel=velocity, moved=didMove;
    resetDrag();

    var absD=Math.abs(localDy),absV=Math.abs(localVel);
    if(moved&&(absD>THRESH||absV>VEL_THRESH)){
      /* fling — dismiss card */
      anim=true;startAnimSafety();
      var dir=localDy<0?-1:(localDy>0?1:(localVel<0?-1:1));
      card._sp={ty:localDy,sc:1-absD*0.0003,rz:localDy*-0.03,op:Math.max(0.15,1-absD/600)};
      card._sv={ty:localVel*0.016,sc:0,rz:0,op:0};
      springTo(card,{ty:dir*-600,sc:0.85,rz:dir*-10,op:0},160,16,function(){
        card._sp=null;card._sv=null;
        if(dir<0)cur=(cur+1)%N; else cur=(cur-1+N)%N;
        layout(false,false);
        clearAnimSafety();anim=false;
      });
    }else if(moved){
      /* short drag — snap back */
      card._sp={ty:localDy,sc:1-absD*0.0003,rz:localDy*-0.03,op:Math.max(0.15,1-absD/600)};
      card._sv={ty:localVel*0.016,sc:0,rz:0,op:0};
      springTo(card,{ty:0,sc:1,rz:0,op:1},220,26);
    }else{
      /* no meaningful movement — navigate */
      var href=card.getAttribute('data-href');
      if(href) window.location.href=href;
    }
  }

  stage.addEventListener('pointerup',finishDrag);
  stage.addEventListener('pointercancel',function(e){
    if(!dragging||!dragCard||e.pointerId!==pointerId)return;
    try{stage.releasePointerCapture(e.pointerId);}catch(ex){}
    var card=dragCard,localDy=dy;
    resetDrag();
    card._sp={ty:localDy,sc:1,rz:0,op:1};card._sv={ty:0,sc:0,rz:0,op:0};
    springTo(card,{ty:0,sc:1,rz:0,op:1},220,26);
  });

  /* prevent touch scroll while dragging */
  stage.addEventListener('touchmove',function(e){if(dragging)e.preventDefault();},{passive:false});

  /* keyboard */
  document.addEventListener('keydown',function(e){
    if(!document.getElementById('AkArchive'))return;
    if(e.key==='ArrowRight'||e.key==='ArrowDown')goNext();
    if(e.key==='ArrowLeft'||e.key==='ArrowUp')goPrev();
  });

  /* init deck — instant (no spring) so rest state is visible on first frame */
  layout(false,true);

  /* =========================================================
     PARTICLE CANVAS — ak-top proven pattern, reduced density
     Dust (no shadowBlur) + floaters (accent glow) + shooters
     DPR capped to 1. IntersectionObserver cancel/restart.
  ========================================================= */
  var cv=document.getElementById('AkArchiveCanvas');
  var prm=false;
  try{prm=window.matchMedia('(prefers-reduced-motion:reduce)').matches;}catch(ex){}
  if(!cv||prm||true) return; /* AmeriKid: ak-archive-canvas ambient particle background disabled for /collections; archive deck drag/tap/arrows/keyboard/layout already initialized above and unaffected (reuses the proven reduced-motion no-particle path) */

  (function(){
    var ctx=cv.getContext('2d',{alpha:true});
    var w=0,h=0,dpr=1; /* DPR capped to 1 */
    var dust=[],floaters=[],shooters=[];
    var nextShooterAt=0,lastFrameTime=0;
    var animationId=null,seededOnce=false,resizeRaf=0;

    var COLORS={
      white:{rgb:'255,255,255',hex:'#ffffff'},
      purple:{rgb:'255,51,255',hex:'#ff33ff'},
      blue:{rgb:'127,212,255',hex:'#7fd4ff'},
      yellow:{rgb:'255,211,74',hex:'#ffd34a'}
    };

    function clamp(v,mn,mx){return Math.min(mx,Math.max(mn,v));}
    function rand(a,b){return a+Math.random()*(b-a);}

    function resize(){
      var rect=root.getBoundingClientRect();
      w=Math.max(1,Math.floor(rect.width));
      h=Math.max(1,Math.floor(rect.height));
      cv.width=w;cv.height=h;
      cv.style.width=w+'px';cv.style.height=h+'px';
      ctx.setTransform(1,0,0,1,0,0);
    }

    function pickAccent(){
      var r=Math.random();
      if(r<0.40)return COLORS.purple;
      if(r<0.72)return COLORS.blue;
      return COLORS.yellow;
    }
    function pickDustColor(){return(Math.random()<0.88)?COLORS.white:pickAccent();}
    function pickFloaterColor(){return(Math.random()<0.76)?COLORS.white:pickAccent();}

    function densityScale(){
      var vw=window.innerWidth||1200;
      if(vw<520)return 0.25;
      if(vw<750)return 0.35;
      return 0.70;
    }

    /* DUST: lightweight, no shadowBlur */
    function seedDust(){
      var area=w*h,s=densityScale();
      var vw=window.innerWidth||1200;
      var tiny=vw<520,mobile=vw<750;
      var div=mobile?(tiny?700:600):500;
      var minC=mobile?(tiny?80:120):300;
      var maxC=mobile?(tiny?200:350):700;
      var count=Math.round(clamp((area/div)*s,minC,maxC));
      dust=new Array(count);
      for(var i=0;i<count;i++){
        var color=pickDustColor();
        var isAccent=(color!==COLORS.white);
        dust[i]={
          bx:rand(0,w),by:rand(0,h),
          vx:rand(-0.025,0.025),vy:rand(-0.020,0.020),
          color:color,isAccent:isAccent,
          a0:isAccent?rand(0.15,0.35):rand(0.04,0.12),
          size:isAccent?rand(1.6,2.8):((Math.random()<0.78)?rand(1.0,2.0):rand(2.0,2.8)),
          tw:rand(0.25,1.10),ph:rand(0,Math.PI*2)
        };
      }
    }

    /* FLOATERS: reduced, accent glow preserved */
    function seedFloaters(){
      var area=w*h,s=densityScale();
      var vw=window.innerWidth||1200;
      var tiny=vw<520,mobile=vw<750;
      var div=mobile?(tiny?8000:7000):2200;
      var minC=mobile?(tiny?30:40):150;
      var maxC=mobile?(tiny?70:100):350;
      var count=Math.round(clamp((area/div)*s,minC,maxC));
      floaters=new Array(count);
      for(var i=0;i<count;i++){
        var color=pickFloaterColor();
        var isAccent=(color!==COLORS.white);
        var a0=isAccent?rand(0.18,0.45):rand(0.06,0.15);
        var r=isAccent?rand(2.5,5.0):((Math.random()<0.6)?rand(1.8,3.2):rand(3.2,4.8));
        var p={
          bx:rand(0,w),by:rand(0,h),
          vx:rand(-0.14,0.14),vy:rand(-0.11,0.11),
          color:color,isAccent:isAccent,
          a0:a0,r:r,tw:rand(0.35,1.35),ph:rand(0,Math.PI*2)
        };
        if(isAccent)p.glowSize=rand(6,14);
        floaters[i]=p;
      }
    }

    /* SHOOTING STARS */
    function scheduleNextShooter(now){nextShooterAt=now+rand(3000,8000);}
    function pickMeteorColor(){return(Math.random()<0.78)?COLORS.white:pickAccent();}

    function spawnShooter(now){
      var fromLeft=Math.random()<0.5;
      var depth=rand(0.4,1.0);
      var y=rand(h*0.05,h*0.95);
      var sx=fromLeft?-rand(50,140):(w+rand(50,140));
      var angle=fromLeft?rand(-0.45,0.45):rand(Math.PI-0.45,Math.PI+0.45);
      var speed=rand(650,1400)*(0.65+depth*0.45);
      var life=rand(0.55,1.15);
      var color=pickMeteorColor();
      shooters.push({
        x:sx,y:y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,
        speed:speed,t:0,life:life,depth:depth,
        tailLen:rand(90,180)*depth*(speed/1000),w:rand(1.0,2.2)*depth,
        color:color,fromLeft:fromLeft
      });
      scheduleNextShooter(now);
    }

    function drawShooter(s,dt){
      var p=clamp(s.t/s.life,0,1);
      var fadeIn=Math.pow(clamp(p/0.12,0,1),0.7);
      var fadeOut=1-Math.pow(clamp((p-0.45)/0.55,0,1),1.8);
      var fa=fadeIn*fadeOut;
      if(fa<0.005)return;
      var spd=Math.sqrt(s.vx*s.vx+s.vy*s.vy)||1;
      var dx=s.vx/spd,dy=s.vy/spd;
      var dtl=s.tailLen*(0.6+0.4*fa);
      var tx=s.x-dx*dtl,ty=s.y-dy*dtl;

      ctx.save();ctx.lineCap='round';
      /* outer glow tail */
      var g1=ctx.createLinearGradient(tx,ty,s.x,s.y);
      g1.addColorStop(0,'rgba('+s.color.rgb+',0)');
      g1.addColorStop(0.5,'rgba('+s.color.rgb+','+(0.08*fa).toFixed(4)+')');
      g1.addColorStop(1,'rgba('+s.color.rgb+','+(0.20*fa).toFixed(4)+')');
      ctx.strokeStyle=g1;ctx.lineWidth=s.w*5*s.depth;
      ctx.beginPath();ctx.moveTo(tx,ty);ctx.lineTo(s.x,s.y);ctx.stroke();
      /* core */
      var g2=ctx.createLinearGradient(tx+(s.x-tx)*0.4,ty+(s.y-ty)*0.4,s.x,s.y);
      g2.addColorStop(0,'rgba(255,255,255,0)');
      g2.addColorStop(0.5,'rgba(255,255,255,'+(0.5*fa).toFixed(4)+')');
      g2.addColorStop(1,'rgba(255,255,255,'+(0.9*fa).toFixed(4)+')');
      ctx.strokeStyle=g2;ctx.lineWidth=s.w*0.9;
      ctx.beginPath();ctx.moveTo(tx+(s.x-tx)*0.4,ty+(s.y-ty)*0.4);ctx.lineTo(s.x,s.y);ctx.stroke();
      /* head dot */
      var hr=s.w*2*s.depth;
      ctx.shadowBlur=10*s.depth;ctx.shadowColor=s.color.hex;
      ctx.fillStyle='rgba(255,255,255,'+(0.9*fa).toFixed(4)+')';
      ctx.beginPath();ctx.arc(s.x,s.y,hr,0,Math.PI*2);ctx.fill();
      ctx.shadowBlur=0;ctx.shadowColor='transparent';
      ctx.restore();
    }

    /* ---- MAIN LOOP ---- */
    function step(t){
      t=t||performance.now();
      var time=t*0.001;
      var rdt=lastFrameTime?clamp((t-lastFrameTime)/1000,0.001,0.05):(1/60);
      lastFrameTime=t;

      ctx.clearRect(0,0,w,h);
      ctx.globalCompositeOperation='lighter';

      /* dust */
      ctx.shadowBlur=0;ctx.shadowColor='transparent';
      for(var i=0;i<dust.length;i++){
        var d=dust[i];
        d.bx+=d.vx;d.by+=d.vy;
        if(d.bx<-3)d.bx=w+3;if(d.bx>w+3)d.bx=-3;
        if(d.by<-3)d.by=h+3;if(d.by>h+3)d.by=-3;
        var twk=0.70+0.30*Math.sin(time*d.tw+d.ph);
        ctx.fillStyle='rgba('+d.color.rgb+','+(d.a0*twk).toFixed(3)+')';
        ctx.fillRect(d.bx-d.size*0.5,d.by-d.size*0.5,d.size,d.size);
      }

      /* floaters */
      for(var j=0;j<floaters.length;j++){
        var f=floaters[j];
        f.bx+=f.vx;f.by+=f.vy;
        if(f.bx<-30)f.bx=w+30;if(f.bx>w+30)f.bx=-30;
        if(f.by<-30)f.by=h+30;if(f.by>h+30)f.by=-30;
        var tw2=0.65+0.35*Math.sin(time*f.tw+f.ph);
        var a2=f.a0*tw2;
        if(f.isAccent&&f.glowSize){
          ctx.shadowBlur=f.glowSize*tw2;ctx.shadowColor=f.color.hex;
        }else{
          ctx.shadowBlur=0;ctx.shadowColor='transparent';
        }
        ctx.fillStyle='rgba('+f.color.rgb+','+a2.toFixed(3)+')';
        ctx.beginPath();ctx.arc(f.bx,f.by,f.r,0,Math.PI*2);ctx.fill();
      }

      /* shooters */
      if(!nextShooterAt)scheduleNextShooter(t);
      if(t>=nextShooterAt)spawnShooter(t);
      for(var k=shooters.length-1;k>=0;k--){
        var s=shooters[k];
        s.t+=rdt;
        s.x+=s.vx*rdt;s.y+=s.vy*rdt;
        drawShooter(s,rdt);
        var mg=300;
        if(s.t>=s.life||s.x<-mg||s.x>w+mg||s.y<-mg||s.y>h+mg)shooters.splice(k,1);
      }

      ctx.globalCompositeOperation='source-over';
      ctx.shadowBlur=0;ctx.shadowColor='transparent';
      animationId=requestAnimationFrame(step);
    }

    function hardSeed(){resize();seedDust();seedFloaters();seededOnce=true;}
    function softResize(){
      var ow=w||1,oh=h||1;
      resize();
      if(!seededOnce){seedDust();seedFloaters();seededOnce=true;return;}
      var sx=w/ow,sy=h/oh;
      for(var i=0;i<dust.length;i++){dust[i].bx*=sx;dust[i].by*=sy;}
      for(var j=0;j<floaters.length;j++){floaters[j].bx*=sx;floaters[j].by*=sy;}
      shooters.length=0;nextShooterAt=0;
    }
    function reqSoftResize(){
      if(resizeRaf)return;
      resizeRaf=requestAnimationFrame(function(){resizeRaf=0;softResize();});
    }

    hardSeed();
    animationId=requestAnimationFrame(step);

    /* offscreen cancel/restart — proven IO pattern */
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting){lastFrameTime=0;if(!animationId)animationId=requestAnimationFrame(step);}
          else{if(animationId){cancelAnimationFrame(animationId);animationId=null;}}
        });
      },{threshold:0});
      io.observe(root);
    }

    window.addEventListener('resize',reqSoftResize,{passive:true});
    if(window.visualViewport)window.visualViewport.addEventListener('resize',reqSoftResize,{passive:true});
    if('ResizeObserver' in window){var ro=new ResizeObserver(function(){reqSoftResize();});ro.observe(root);}
  })();

})();
</script>

{% schema %}
{
  "name": "Archive Card Stack",
  "tag": "section",
  "class": "ak-archive-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "Archive Card Stack"
    }
  ]
}
{% endschema %}
