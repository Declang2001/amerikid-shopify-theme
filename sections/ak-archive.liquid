{% comment %}
  ak-archive.liquid v6 — Archive folder-deck for /collections/
  18 collection folders. Self-contained: all CSS + JS inline.
  v6: structural fix — cards bottom-aligned in taller stage so trailing
  strips are always visible. Div-based cards with JS navigation.
  Simplified drag model. Spring cancellation prevents orphaned animations.
{% endcomment %}

{%- style -%}
/* ===== AK-ARCHIVE v6 ===== */
/* kill white body bg bleed on Archive route */
.ak-archive-section{background:#000}

.ak-archive{
  position:relative;width:100%;
  height:100vh;height:100dvh;
  background:#000;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
  padding-bottom:clamp(30px,4vh,60px); /* bias deck slightly upward */
  user-select:none;-webkit-user-select:none;
}

/* — particle canvas — */
.ak-archive-canvas{
  position:absolute;inset:0;
  width:100%;height:100%;
  pointer-events:none;z-index:0;
  mix-blend-mode:screen;
}

/* — stage: taller than card to hold the fan — */
.ak-archive-stage{
  position:relative;z-index:5;
  width:clamp(320px, 72vw, 920px);
  /* stage is tall enough for the card + ~160px of trailing fan above it */
  height:clamp(340px, 52vw, 640px);
}

/* — folder card — */
.ak-archive-card{
  position:absolute;
  left:0;right:0;bottom:0;
  height:76%; /* card fills bottom 76% of stage — top 24% is fan headroom */
  border-radius:14px;overflow:visible;
  will-change:transform,opacity;
  transform-origin:center bottom;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
  text-decoration:none;color:inherit;
  display:block;
}
.ak-archive-card[data-active="false"]{
  pointer-events:none;
}

/* folder inner clip */
.ak-archive-card-inner{
  position:relative;width:100%;height:100%;
  border-radius:14px;overflow:hidden;
  background:#111;
  border:1px solid rgba(255,255,255,0.05);
}
.ak-archive-card[data-depth="1"] .ak-archive-card-inner,
.ak-archive-card[data-depth="2"] .ak-archive-card-inner,
.ak-archive-card[data-depth="3"] .ak-archive-card-inner,
.ak-archive-card[data-depth="4"] .ak-archive-card-inner,
.ak-archive-card[data-depth="5"] .ak-archive-card-inner{
  border-color:rgba(255,255,255,0.10);
}

/* folder tab on trailing cards */
.ak-archive-tab{
  position:absolute;
  top:-18px;left:24px;
  width:72px;height:20px;
  background:#222;
  border-radius:6px 6px 0 0;
  border:1px solid rgba(255,255,255,0.10);
  border-bottom:none;
  pointer-events:none;
  opacity:0;
  transition:opacity .3s ease;
}
.ak-archive-card[data-depth="1"] .ak-archive-tab,
.ak-archive-card[data-depth="2"] .ak-archive-tab,
.ak-archive-card[data-depth="3"] .ak-archive-tab,
.ak-archive-card[data-depth="4"] .ak-archive-tab,
.ak-archive-card[data-depth="5"] .ak-archive-tab{
  opacity:1;
}
.ak-archive-card[data-depth="1"] .ak-archive-tab{left:24px;width:72px;background:#2a2a2a}
.ak-archive-card[data-depth="2"] .ak-archive-tab{left:44px;width:64px;background:#252525}
.ak-archive-card[data-depth="3"] .ak-archive-tab{left:60px;width:56px;background:#202020}
.ak-archive-card[data-depth="4"] .ak-archive-tab{left:72px;width:48px;background:#1c1c1c}
.ak-archive-card[data-depth="5"] .ak-archive-tab{left:82px;width:40px;background:#181818}

.ak-archive-card img{
  display:block;width:100%;height:100%;
  object-fit:cover;pointer-events:none;
  -webkit-user-drag:none;
  user-select:none;-webkit-user-select:none;
}

/* — title label — */
.ak-archive-label{
  position:absolute;bottom:0;left:0;right:0;
  padding:28px 24px 22px;
  background:linear-gradient(to top,
    rgba(0,0,0,0.92) 0%,
    rgba(0,0,0,0.6) 50%,
    transparent 100%);
  pointer-events:none;
}
.ak-archive-title{
  font-family:Impact,sans-serif;
  font-size:clamp(1.5rem,3.2vw,2.6rem);
  line-height:1.1;color:#fff;margin:0;
  letter-spacing:0.015em;
  text-transform:uppercase;
  text-shadow:0 2px 12px rgba(0,0,0,0.5);
}

/* — prev / next buttons — */
.ak-archive-prev,
.ak-archive-next{
  position:absolute;top:50%;z-index:30;
  width:48px;height:48px;border-radius:50%;
  border:1.5px solid rgba(255,255,255,0.2);
  background:rgba(0,0,0,0.45);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  color:#fff;display:flex;align-items:center;justify-content:center;
  cursor:pointer;padding:0;
  transition:transform .18s ease,border-color .18s ease,background .18s ease;
  -webkit-tap-highlight-color:transparent;
}
.ak-archive-prev{left:clamp(10px,2.5vw,28px);transform:translateY(-50%)}
.ak-archive-next{right:clamp(10px,2.5vw,28px);transform:translateY(-50%)}
.ak-archive-prev:hover,.ak-archive-next:hover{
  border-color:rgba(255,255,255,0.45);
  background:rgba(255,255,255,0.08);
}
.ak-archive-prev:active{transform:translateY(-50%) scale(0.92)}
.ak-archive-next:active{transform:translateY(-50%) scale(0.92)}
.ak-archive-prev svg,.ak-archive-next svg{
  width:22px;height:22px;fill:none;
  stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* — responsive — */
@media(max-width:680px){
  .ak-archive-stage{
    width:92vw;
    height:clamp(280px, 65vw, 500px);
  }
  .ak-archive-label{padding:20px 16px 16px}
  .ak-archive-prev,.ak-archive-next{width:40px;height:40px}
  .ak-archive-prev svg,.ak-archive-next svg{width:18px;height:18px}
  .ak-archive-tab{top:-14px;height:16px}
}

/* reduced motion */
@media(prefers-reduced-motion:reduce){
  .ak-archive-canvas{display:none}
}

/* ===== CASSETTE CASE SKIN =====
   Visual-only reskin. Turns flat cards into cassette-case / cassette-box
   objects with visible housing, inset cover-art window, plastic sheen,
   hinge line, and spine-style trailing tabs.
   REMOVE THIS ENTIRE BLOCK to revert to folder-deck appearance.
   No JS, no HTML, no layout changes. */

/* — case housing: visible shell frame around cover art — */
.ak-archive-card-inner{
  padding:8px 8px 0 8px;
  border-radius:6px;
  background:linear-gradient(168deg,#1a1a1a 0%,#0e0e0e 40%,#111 100%);
  border:1px solid rgba(255,255,255,0.08);
}

/* front card gets a slightly brighter shell edge */
.ak-archive-card[data-depth="0"] .ak-archive-card-inner{
  border-color:rgba(255,255,255,0.12);
}

/* — cover art insert: inset with small radius — */
.ak-archive-card img{
  border-radius:3px;
  height:calc(100% - 8px); /* account for top padding; bottom has 0 padding so label overlaps */
}

/* — plastic sheen: diagonal highlight across the case surface — */
.ak-archive-card-inner::before{
  content:"";
  position:absolute;
  inset:0;
  z-index:2;
  pointer-events:none;
  border-radius:inherit;
  background:linear-gradient(
    135deg,
    rgba(255,255,255,0.06) 0%,
    rgba(255,255,255,0.02) 25%,
    transparent 50%,
    rgba(255,255,255,0.01) 75%,
    rgba(255,255,255,0.04) 100%
  );
  mix-blend-mode:screen;
}

/* — case hinge: thin vertical accent on left edge — */
.ak-archive-card-inner::after{
  content:"";
  position:absolute;
  left:0;top:8px;bottom:0;
  width:3px;
  z-index:3;
  pointer-events:none;
  background:linear-gradient(to bottom,
    rgba(255,255,255,0.08) 0%,
    rgba(255,255,255,0.04) 30%,
    rgba(255,255,255,0.02) 70%,
    rgba(255,255,255,0.06) 100%
  );
  border-radius:3px 0 0 3px;
}

/* — snap-ridge: horizontal line near top of case — */
/* (achieved via a top border on the image that reads as the lid-closure ridge) */
.ak-archive-card img{
  box-shadow:0 -1px 0 0 rgba(255,255,255,0.06);
}

/* — title label: adjust for inset art + slightly more "printed on case" feel — */
.ak-archive-label{
  left:8px;right:8px;
  border-radius:0 0 3px 3px;
  padding:24px 18px 18px;
}

/* — trailing card tabs → case spines — */
.ak-archive-tab{
  width:auto;
  min-width:56px;
  height:22px;
  border-radius:4px 4px 0 0;
  background:linear-gradient(to bottom,#2a2a2a,#1e1e1e);
  border:1px solid rgba(255,255,255,0.08);
  border-bottom:none;
  /* subtle spine ridge */
  box-shadow:inset 0 1px 0 rgba(255,255,255,0.06);
}
/* stagger spines more like stacked cases */
.ak-archive-card[data-depth="1"] .ak-archive-tab{left:20px;min-width:80px;background:linear-gradient(to bottom,#2c2c2c,#202020)}
.ak-archive-card[data-depth="2"] .ak-archive-tab{left:38px;min-width:70px;background:linear-gradient(to bottom,#272727,#1c1c1c)}
.ak-archive-card[data-depth="3"] .ak-archive-tab{left:54px;min-width:60px;background:linear-gradient(to bottom,#222,#191919)}
.ak-archive-card[data-depth="4"] .ak-archive-tab{left:66px;min-width:52px;background:linear-gradient(to bottom,#1e1e1e,#161616)}
.ak-archive-card[data-depth="5"] .ak-archive-tab{left:76px;min-width:44px;background:linear-gradient(to bottom,#1a1a1a,#141414)}

/* trailing card inner border — case edges visible in stack */
.ak-archive-card[data-depth="1"] .ak-archive-card-inner,
.ak-archive-card[data-depth="2"] .ak-archive-card-inner,
.ak-archive-card[data-depth="3"] .ak-archive-card-inner,
.ak-archive-card[data-depth="4"] .ak-archive-card-inner,
.ak-archive-card[data-depth="5"] .ak-archive-card-inner{
  border-color:rgba(255,255,255,0.09);
}

/* — mobile responsive for case skin — */
@media(max-width:680px){
  .ak-archive-card-inner{
    padding:6px 6px 0 6px;
  }
  .ak-archive-card img{
    height:calc(100% - 6px);
    border-radius:2px;
  }
  .ak-archive-card-inner::after{
    top:6px;width:2px;
  }
  .ak-archive-label{
    left:6px;right:6px;
    padding:18px 12px 12px;
  }
  .ak-archive-tab{
    top:-16px;height:18px;
    min-width:48px;
  }
}

/* ===== END CASSETTE CASE SKIN ===== */
{%- endstyle -%}

