{% comment %}
  ak-archive.liquid — Wide-format card-deck Archive for /collections/
  18 collection cards. Drag/swipe/click/keyboard navigation.
  Self-contained: all CSS + JS inline. No external deps.
{% endcomment %}

{%- style -%}
/* ===== AK-ARCHIVE DECK ===== */
.ak-archive{
  position:relative;width:100%;
  height:100vh;height:100dvh;
  background:#000;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
  user-select:none;-webkit-user-select:none;
  touch-action:pan-x;
}

/* — stage — */
.ak-archive-stage{
  position:relative;
  width:clamp(320px, 72vw, 920px);
  aspect-ratio:16/10;
  max-height:68vh;max-height:68dvh;
}

/* — card — */
.ak-archive-card{
  position:absolute;inset:0;
  border-radius:16px;overflow:hidden;
  will-change:transform,opacity;
  transform-origin:center 80%;
  box-shadow:0 8px 30px rgba(0,0,0,0.6);
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
  text-decoration:none;color:inherit;
  display:block;
}
.ak-archive-card[data-active="false"]{
  pointer-events:none;
}
.ak-archive-card img{
  display:block;width:100%;height:100%;
  object-fit:cover;pointer-events:none;
  -webkit-user-drag:none;
}

/* — title label — */
.ak-archive-label{
  position:absolute;bottom:0;left:0;right:0;
  padding:28px 24px 22px;
  background:linear-gradient(to top,
    rgba(0,0,0,0.92) 0%,
    rgba(0,0,0,0.6) 50%,
    transparent 100%);
  pointer-events:none;
}
.ak-archive-title{
  font-family:Impact,sans-serif;
  font-size:clamp(1.5rem,3.2vw,2.6rem);
  line-height:1.1;color:#fff;margin:0;
  letter-spacing:0.015em;
  text-shadow:0 2px 12px rgba(0,0,0,0.5);
}

/* — prev / next buttons — */
.ak-archive-prev,
.ak-archive-next{
  position:absolute;top:50%;z-index:30;
  width:48px;height:48px;border-radius:50%;
  border:1.5px solid rgba(255,255,255,0.2);
  background:rgba(0,0,0,0.45);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  color:#fff;display:flex;align-items:center;justify-content:center;
  cursor:pointer;padding:0;
  transition:transform .18s ease,border-color .18s ease,background .18s ease;
  -webkit-tap-highlight-color:transparent;
}
.ak-archive-prev{left:clamp(10px,2.5vw,28px);transform:translateY(-50%)}
.ak-archive-next{right:clamp(10px,2.5vw,28px);transform:translateY(-50%)}
.ak-archive-prev:hover,.ak-archive-next:hover{
  border-color:rgba(255,255,255,0.45);
  background:rgba(255,255,255,0.08);
}
.ak-archive-prev:active{transform:translateY(-50%) scale(0.92)}
.ak-archive-next:active{transform:translateY(-50%) scale(0.92)}
.ak-archive-prev svg,.ak-archive-next svg{
  width:22px;height:22px;fill:none;
  stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* — bottom bar: counter + progress rail — */
.ak-archive-bar{
  position:absolute;
  bottom:clamp(16px,3.5vh,34px);
  left:50%;transform:translateX(-50%);
  display:flex;align-items:center;gap:14px;
  z-index:30;
}
.ak-archive-counter{
  font-family:Impact,sans-serif;
  font-size:0.95rem;letter-spacing:0.08em;
  color:rgba(255,255,255,0.55);
  white-space:nowrap;
  min-width:3.6em;text-align:center;
}
.ak-archive-rail{
  width:clamp(100px,18vw,200px);height:3px;
  background:rgba(255,255,255,0.12);
  border-radius:2px;overflow:hidden;
  position:relative;
}
.ak-archive-fill{
  position:absolute;left:0;top:0;height:100%;
  background:#fff;border-radius:2px;
  transition:width .4s cubic-bezier(.22,1,.36,1);
}

/* — tap zones — */
.ak-archive-tap{
  position:absolute;top:0;bottom:0;z-index:20;
  cursor:pointer;-webkit-tap-highlight-color:transparent;
}
.ak-archive-tap--prev{left:0;width:25%}
.ak-archive-tap--next{right:0;width:25%}

/* — responsive — */
@media(max-width:680px){
  .ak-archive-stage{
    width:92vw;
    aspect-ratio:4/3;
    max-height:55vh;max-height:55dvh;
  }
  .ak-archive-label{padding:20px 16px 16px}
  .ak-archive-prev,.ak-archive-next{width:40px;height:40px}
  .ak-archive-prev svg,.ak-archive-next svg{width:18px;height:18px}
}
@media(max-width:400px){
  .ak-archive-stage{aspect-ratio:3/2}
}
{%- endstyle -%}

