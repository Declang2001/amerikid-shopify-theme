<script>
(function(){
  /* ---- config ---- */
  var TOTAL = 18;
  var OFFSET_Y = -8;       /* px per stacked card (negative = upward peek) */
  var SCALE_STEP = 0.04;   /* scale reduction per depth level */
  var DIM_STEP = 0.12;     /* brightness reduction per depth level */
  var MAX_VISIBLE = 5;     /* how many cards to render in the visible stack */
  var SWIPE_THRESHOLD = 50; /* px drag distance to trigger advance */

  /* ---- state ---- */
  var current = 0;
  var cards = [].slice.call(document.querySelectorAll('.ak-archive-card'));
  var dots = [].slice.call(document.querySelectorAll('.ak-archive-dot'));
  var counter = document.getElementById('AkArchiveCounter');
  var dragging = false;
  var dragStartY = 0;
  var dragDeltaY = 0;
  var dragCard = null;
  var didDrag = false;

  /* ---- layout ---- */
  function layout() {
    for (var i = 0; i < TOTAL; i++) {
      var card = cards[i];
      /* position relative to current front card */
      var depth = (i - current + TOTAL) % TOTAL;
      if (depth >= MAX_VISIBLE) {
        card.style.opacity = '0';
        card.style.pointerEvents = 'none';
        card.style.zIndex = 0;
        continue;
      }
      var ty = depth * OFFSET_Y;
      var sc = 1 - depth * SCALE_STEP;
      var bright = Math.max(0.35, 1 - depth * DIM_STEP);
      card.style.transform = 'translateY(' + ty + 'px) scale(' + sc + ')';
      card.style.opacity = depth === 0 ? '1' : String(Math.max(0.5, 1 - depth * 0.2));
      card.style.filter = 'brightness(' + bright + ')';
      card.style.zIndex = TOTAL - depth;
      card.style.pointerEvents = depth === 0 ? 'auto' : 'none';
    }
    /* update dots */
    for (var d = 0; d < dots.length; d++) {
      dots[d].classList.toggle('is-active', d === current);
    }
    /* update counter */
    counter.textContent = (current + 1) + ' / ' + TOTAL;
  }

  function goNext() {
    current = (current + 1) % TOTAL;
    layout();
  }

  function goPrev() {
    current = (current - 1 + TOTAL) % TOTAL;
    layout();
  }

  /* ---- button controls ---- */
  document.getElementById('AkArchiveNext').addEventListener('click', goNext);
  document.getElementById('AkArchivePrev').addEventListener('click', goPrev);

  /* ---- tap zones ---- */
  document.getElementById('AkArchiveTapNext').addEventListener('click', goNext);
  document.getElementById('AkArchiveTapPrev').addEventListener('click', goPrev);

  /* ---- drag / swipe on front card ---- */
  function onPointerDown(e) {
    var card = e.target.closest('.ak-archive-card');
    if (!card || parseInt(card.getAttribute('data-card')) !== current) return;
    dragging = true;
    didDrag = false;
    dragCard = card;
    dragStartY = e.clientY || (e.touches && e.touches[0].clientY) || 0;
    dragDeltaY = 0;
    card.setAttribute('data-dragging', 'true');
  }

  function onPointerMove(e) {
    if (!dragging || !dragCard) return;
    var clientY = e.clientY || (e.touches && e.touches[0].clientY) || 0;
    dragDeltaY = clientY - dragStartY;
    /* only allow upward drag (negative deltaY) for advancing */
    if (Math.abs(dragDeltaY) > 5) didDrag = true;
    dragCard.style.transform = 'translateY(' + dragDeltaY + 'px) scale(1) rotate(' + (dragDeltaY * -0.03) + 'deg)';
    dragCard.style.opacity = String(Math.max(0.2, 1 - Math.abs(dragDeltaY) / 400));
  }

  function onPointerUp(e) {
    if (!dragging || !dragCard) return;
    dragging = false;
    dragCard.removeAttribute('data-dragging');
    if (Math.abs(dragDeltaY) > SWIPE_THRESHOLD) {
      /* animate card off-screen briefly */
      var exitY = dragDeltaY < 0 ? -600 : 600;
      dragCard.style.transition = 'transform 0.25s ease-out, opacity 0.25s ease-out';
      dragCard.style.transform = 'translateY(' + exitY + 'px) scale(0.9) rotate(' + (dragDeltaY * -0.06) + 'deg)';
      dragCard.style.opacity = '0';
      var ref = dragCard;
      setTimeout(function(){
        ref.style.transition = '';
        if (dragDeltaY < 0) {
          goNext();
        } else {
          goPrev();
        }
      }, 260);
    } else {
      /* snap back */
      dragCard.style.transition = 'transform 0.35s cubic-bezier(0.22,1,0.36,1), opacity 0.35s cubic-bezier(0.22,1,0.36,1)';
      dragCard.style.transform = 'translateY(0) scale(1)';
      dragCard.style.opacity = '1';
      setTimeout(function(){
        if (dragCard) dragCard.style.transition = '';
      }, 360);
    }
    dragCard = null;
    dragDeltaY = 0;
  }

  /* ---- prevent navigation on drag ---- */
  cards.forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (didDrag) {
        e.preventDefault();
        didDrag = false;
      }
    });
  });

  /* mouse events on stage */
  var stage = document.getElementById('AkArchive');
  stage.addEventListener('mousedown', onPointerDown);
  stage.addEventListener('mousemove', onPointerMove);
  stage.addEventListener('mouseup', onPointerUp);
  stage.addEventListener('mouseleave', onPointerUp);

  /* touch events */
  stage.addEventListener('touchstart', function(e){
    if (!e.touches[0]) return;
    var t = e.touches[0];
    onPointerDown({target: e.target, clientY: t.clientY});
  }, {passive: true});
  stage.addEventListener('touchmove', function(e){
    if (!e.touches[0]) return;
    if (dragging) e.preventDefault();
    onPointerMove({clientY: e.touches[0].clientY});
  }, {passive: false});
  stage.addEventListener('touchend', function(e){
    onPointerUp(e);
  }, {passive: true});

  /* ---- keyboard ---- */
  document.addEventListener('keydown', function(e) {
    if (!document.getElementById('AkArchive')) return;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') goNext();
    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') goPrev();
  });

  /* ---- init ---- */
  layout();
})();
</script>

{% schema %}
{
  "name": "Archive Card Stack",
  "tag": "section",
  "class": "ak-archive-section",
  "settings": [
    {
      "type": "color_scheme",
