{% comment %}
  ak-archive.liquid — Card-stack Archive selector for /collections/
  Stage 1 shell: 18 collection cards, stacked viewport, click/tap/drag navigation.
  All CSS and JS self-contained. No external dependencies beyond Shopify CDN images.
{% endcomment %}

{%- style -%}
/* ===== AK-ARCHIVE — STAGE 1 ===== */
.ak-archive {
  position: relative;
  width: 100%;
  height: calc(100vh - 0px);
  height: calc(100dvh - 0px);
  background: #000;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
  -webkit-user-select: none;
  touch-action: pan-x;
}

/* — card stage — */
.ak-archive-stage {
  position: relative;
  width: min(420px, 82vw);
  aspect-ratio: 5 / 7;
  max-height: 70vh;
  max-height: 70dvh;
}

/* — individual card — */
.ak-archive-card {
  position: absolute;
  inset: 0;
  border-radius: 14px;
  overflow: hidden;
  will-change: transform, opacity;
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
              opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
              filter 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.ak-archive-card[data-dragging="true"] {
  transition: none;
  cursor: grabbing;
}

/* card image */
.ak-archive-card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
  -webkit-user-drag: none;
}

/* card title label */
.ak-archive-card-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px 18px 18px;
  background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.55) 60%, transparent 100%);
  pointer-events: none;
}
.ak-archive-card-title {
  font-family: Impact, sans-serif;
  font-size: clamp(1.4rem, 4.5vw, 2.2rem);
  line-height: 1.1;
  color: #fff;
  margin: 0;
  letter-spacing: 0.02em;
}

/* — navigation controls — */
.ak-archive-nav {
  position: absolute;
  bottom: clamp(18px, 4vh, 36px);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 18px;
  z-index: 20;
}
.ak-archive-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.25);
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  -webkit-tap-highlight-color: transparent;
  padding: 0;
}
.ak-archive-btn:hover {
  border-color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.08);
}
.ak-archive-btn svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* — progress dots — */
.ak-archive-dots {
  display: flex;
  gap: 5px;
  align-items: center;
}
.ak-archive-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  transition: width 0.3s, background 0.3s, border-radius 0.3s;
}
.ak-archive-dot.is-active {
  width: 22px;
  border-radius: 3px;
  background: #fff;
}

/* — counter — */
.ak-archive-counter {
  position: absolute;
  top: clamp(14px, 3vh, 28px);
  right: clamp(14px, 3vw, 28px);
  font-family: Impact, sans-serif;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.45);
  letter-spacing: 0.06em;
  z-index: 20;
  pointer-events: none;
}

/* — tap zones (invisible) — */
.ak-archive-tap-prev,
.ak-archive-tap-next {
  position: absolute;
  top: 0;
  bottom: 80px;
  width: 30%;
  z-index: 15;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.ak-archive-tap-prev { left: 0; }
.ak-archive-tap-next { right: 0; }

/* — mobile adjustments — */
@media (max-width: 480px) {
  .ak-archive-stage {
    width: 88vw;
  }
  .ak-archive-nav {
    gap: 12px;
  }
  .ak-archive-dot {
    width: 5px;
    height: 5px;
  }
  .ak-archive-dot.is-active {
    width: 16px;
  }
}
{%- endstyle -%}

