<script>
(function(){
  'use strict';
  var N=18, VIS=4;
  /* depth layout params */
  var OFFSET_Y=14, OFFSET_X=0, SCALE_STEP=0.045, ROT_STEP=1.2;
  /* drag */
  var THRESH=60;

  var cards=[].slice.call(document.querySelectorAll('.ak-archive-card'));
  var counter=document.getElementById('AkCounter');
  var fill=document.getElementById('AkFill');
  var root=document.getElementById('AkArchive');
  var cur=0, anim=false;

  /* ---- spring helper ---- */
  function springTo(el,props,k,d,cb){
    /* simple critically-damped spring via rAF */
    var keys=Object.keys(props);
    var vel={},pos={};
    keys.forEach(function(p){pos[p]=parseFloat(el._sp&&el._sp[p]||0);vel[p]=el._sv&&el._sv[p]||0;});
    el._sp=pos;el._sv=vel;
    var stiff=k||170,damp=d||22;
    var done=false;
    function tick(){
      if(done)return;
      var allDone=true;
      keys.forEach(function(p){
        var x=pos[p],v=vel[p],target=props[p];
        var spring=-stiff*(x-target);
        var damping=-damp*v;
        var a=spring+damping;
        v+=a*0.016;x+=v*0.016;
        if(Math.abs(x-target)<0.3&&Math.abs(v)<0.5){x=target;v=0;}
        else{allDone=false;}
        pos[p]=x;vel[p]=v;
      });
      el._sp=pos;el._sv=vel;
      applyTransform(el,pos);
      if(allDone){done=true;if(cb)cb();}
      else{requestAnimationFrame(tick);}
    }
    requestAnimationFrame(tick);
    return function(){done=true;};
  }

  function applyTransform(el,p){
    var ty=p.ty||0,sc=p.sc||1,rot=p.rot||0,ox=p.ox||0,op=p.op;
    el.style.transform='translate('+ox+'px,'+ty+'px) scale('+sc.toFixed(4)+') rotate('+rot.toFixed(2)+'deg)';
    if(op!==undefined)el.style.opacity=Math.max(0,Math.min(1,op)).toFixed(3);
  }

  /* ---- layout ---- */
  function layout(skipFront){
    for(var i=0;i<N;i++){
      var c=cards[i];
      var depth=(i-cur+N)%N;
      if(depth>=VIS){
        c.style.opacity='0';c.style.zIndex=0;
        c.setAttribute('data-active','false');
        c._sp=null;c._sv=null;
        continue;
      }
      c.setAttribute('data-active',depth===0?'true':'false');
      c.style.zIndex=N-depth;
      c.style.boxShadow=depth===0
        ?'0 12px 50px rgba(0,0,0,0.7), 0 2px 8px rgba(0,0,0,0.4)'
        :'0 '+((depth+1)*4)+'px '+(20+depth*8)+'px rgba(0,0,0,'+(0.4+depth*0.1).toFixed(1)+')';
      if(depth===0&&skipFront)continue;
      var target={
        ty:depth*OFFSET_Y,
        ox:depth*OFFSET_X,
        sc:1-depth*SCALE_STEP,
        rot:depth*ROT_STEP,
        op:depth===0?1:Math.max(0.45, 1-depth*0.22)
      };
      springTo(c,target,200,24);
    }
    /* counter + rail */
    var num=cur+1;
    counter.textContent=(num<10?'0':'')+num+' / '+N;
    fill.style.width=(num/N*100).toFixed(1)+'%';
  }

  /* ---- navigate ---- */
  function goNext(){
    if(anim)return;
    anim=true;
    var front=cards[cur];
    /* spring the front card off-screen upward with rotation */
    springTo(front,{ty:-500,sc:0.88,rot:-8,op:0},180,18,function(){
      front._sp=null;front._sv=null;
      cur=(cur+1)%N;
      layout(false);
      anim=false;
    });
    /* simultaneously spring the next cards into their new positions */
    var next1=(cur+1)%N, next2=(cur+2)%N, next3=(cur+3)%N;
    [next1,next2,next3].forEach(function(idx){
      var c=cards[idx];
      var futureDepth=(idx-(cur+1)+N)%N;
      if(futureDepth>=VIS)return;
      c.style.zIndex=N-futureDepth;
      c.style.opacity=futureDepth===0?'1':String(Math.max(0.45,1-futureDepth*0.22));
      c.setAttribute('data-active',futureDepth===0?'true':'false');
      springTo(c,{
        ty:futureDepth*OFFSET_Y,
        ox:futureDepth*OFFSET_X,
        sc:1-futureDepth*SCALE_STEP,
        rot:futureDepth*ROT_STEP,
        op:futureDepth===0?1:Math.max(0.45,1-futureDepth*0.22)
      },200,24);
    });
    /* update counter immediately for responsiveness */
    var num=((cur+1)%N)+1;
    counter.textContent=(num<10?'0':'')+num+' / '+N;
    fill.style.width=(num/N*100).toFixed(1)+'%';
  }

  function goPrev(){
    if(anim)return;
    anim=true;
    var front=cards[cur];
    /* spring front card off to the right-down */
    springTo(front,{ty:400,sc:0.88,rot:8,op:0},180,18,function(){
      front._sp=null;front._sv=null;
      cur=(cur-1+N)%N;
      layout(false);
      anim=false;
    });
    var prev1=(cur-1+N)%N;
    var c=cards[prev1];
    c.style.zIndex=N;c.style.opacity='0';
    c.setAttribute('data-active','true');
    c._sp={ty:-300,sc:0.92,rot:-6,op:0,ox:0};c._sv={ty:0,sc:0,rot:0,op:0,ox:0};
    applyTransform(c,c._sp);
    springTo(c,{ty:0,sc:1,rot:0,op:1,ox:0},200,24);
    var num=((cur-1+N)%N)+1;
    counter.textContent=(num<10?'0':'')+num+' / '+N;
    fill.style.width=(num/N*100).toFixed(1)+'%';
  }

  /* ---- controls ---- */
  document.getElementById('AkNext').addEventListener('click',goNext);
  document.getElementById('AkPrev').addEventListener('click',goPrev);
  document.getElementById('AkTapNext').addEventListener('click',goNext);
  document.getElementById('AkTapPrev').addEventListener('click',goPrev);

  /* ---- drag ---- */
  var dragging=false,dragCard=null,startY=0,dy=0,didDrag=false,lastTime=0,velocity=0;

  function ptrDown(e){
    if(anim)return;
    var el=e.target;
    if(el&&el.closest)el=el.closest('.ak-archive-card');
    if(!el||el.getAttribute('data-active')!=='true')return;
    dragging=true;didDrag=false;
    dragCard=el;
    startY=e.clientY;dy=0;velocity=0;lastTime=Date.now();
    /* kill any running spring on this card */
    dragCard._sp={ty:0,sc:1,rot:0,op:1,ox:0};
    dragCard._sv={ty:0,sc:0,rot:0,op:0,ox:0};
  }
  function ptrMove(e){
    if(!dragging||!dragCard)return;
    var clientY=e.clientY;
    var now=Date.now();
    var dt=Math.max(1,now-lastTime);
    var newDy=clientY-startY;
    velocity=(newDy-dy)/dt*1000; /* px/s */
    dy=newDy;lastTime=now;
    if(Math.abs(dy)>4)didDrag=true;
    /* live transform with rubber-band feel */
    var rot=dy*-0.04;
    var sc=1-Math.abs(dy)*0.0003;
    var op=1-Math.abs(dy)/600;
    dragCard.style.transform='translateY('+dy+'px) scale('+sc.toFixed(4)+') rotate('+rot.toFixed(2)+'deg)';
    dragCard.style.opacity=Math.max(0.15,op).toFixed(3);
  }
  function ptrUp(){
    if(!dragging||!dragCard)return;
    dragging=false;
    var card=dragCard;dragCard=null;
    var absD=Math.abs(dy),absV=Math.abs(velocity);
    /* determine if swipe is strong enough */
    if(absD>THRESH||absV>600){
      anim=true;
      var dir=dy<0?-1:(dy>0?1:(velocity<0?-1:1));
      springTo(card,{ty:dir*-600,sc:0.85,rot:dir*-12,op:0},160,16,function(){
        card._sp=null;card._sv=null;
        if(dir<0)cur=(cur+1)%N; else cur=(cur-1+N)%N;
        layout(false);
        anim=false;
      });
      var num=(dir<0?(cur+1)%N:(cur-1+N)%N)+1;
      counter.textContent=(num<10?'0':'')+num+' / '+N;
      fill.style.width=(num/N*100).toFixed(1)+'%';
    }else{
      /* snap back via spring */
      card._sp={ty:dy,sc:1-Math.abs(dy)*0.0003,rot:dy*-0.04,op:Math.max(0.15,1-Math.abs(dy)/600),ox:0};
      card._sv={ty:velocity*0.016,sc:0,rot:0,op:0,ox:0};
      springTo(card,{ty:0,sc:1,rot:0,op:1,ox:0},220,26);
    }
    dy=0;velocity=0;
  }

  /* prevent link nav on drag */
  cards.forEach(function(c){
    c.addEventListener('click',function(e){if(didDrag){e.preventDefault();didDrag=false;}});
  });

  /* mouse */
  root.addEventListener('mousedown',ptrDown);
  root.addEventListener('mousemove',ptrMove);
  root.addEventListener('mouseup',ptrUp);
  root.addEventListener('mouseleave',ptrUp);
  /* touch */
  root.addEventListener('touchstart',function(e){
    if(!e.touches[0])return;
    ptrDown({target:e.target,clientY:e.touches[0].clientY});
  },{passive:true});
  root.addEventListener('touchmove',function(e){
    if(!e.touches[0])return;
    if(dragging)e.preventDefault();
    ptrMove({clientY:e.touches[0].clientY});
  },{passive:false});
  root.addEventListener('touchend',function(){ptrUp();},{passive:true});

  /* keyboard */
  document.addEventListener('keydown',function(e){
    if(!document.getElementById('AkArchive'))return;
    if(e.key==='ArrowRight'||e.key==='ArrowDown')goNext();
    if(e.key==='ArrowLeft'||e.key==='ArrowUp')goPrev();
  });

  /* init */
  layout(false);
})();
</script>

