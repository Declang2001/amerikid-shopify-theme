  .ak-products-page .ak-top-products:hover::before, .ak-products-page .ak-top-products:focus-visible::before, .ak-products-page .ak-top-products:active::before,
  .ak-products-page .ak-top-archive:hover::before, .ak-products-page .ak-top-archive:focus-visible::before, .ak-products-page .ak-top-archive:active::before,
  .ak-products-page .ak-top-narrative:hover::before, .ak-products-page .ak-top-narrative:focus-visible::before, .ak-products-page .ak-top-narrative:active::before,
  .ak-products-page .ak-top-contact:hover::before, .ak-products-page .ak-top-contact:focus-visible::before, .ak-products-page .ak-top-contact:active::before{
    background-color:#ff33ff !important;
  }
  /* ACTIVE / CURRENT-PAGE CUE — PRODUCTS on this route: purple wordmark +
