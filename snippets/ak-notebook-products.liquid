  }
  /* keep the five labels in the DOM for screen readers, but visually hidden in ALL states */
  .ak-products-page .ak-top-life .ak-top-label, .ak-products-page .ak-top-life:hover .ak-top-label, .ak-products-page .ak-top-life:focus-visible .ak-top-label, .ak-products-page .ak-top-life:active .ak-top-label, .ak-products-page .ak-top-life.is-active .ak-top-label,
  .ak-products-page .ak-top-products .ak-top-label, .ak-products-page .ak-top-products:hover .ak-top-label, .ak-products-page .ak-top-products:focus-visible .ak-top-label, .ak-products-page .ak-top-products:active .ak-top-label, .ak-products-page .ak-top-products.is-active .ak-top-label,
  .ak-products-page .ak-top-archive .ak-top-label, .ak-products-page .ak-top-archive:hover .ak-top-label, .ak-products-page .ak-top-archive:focus-visible .ak-top-label, .ak-products-page .ak-top-archive:active .ak-top-label, .ak-products-page .ak-top-archive.is-active .ak-top-label,
  .ak-products-page .ak-top-narrative .ak-top-label, .ak-products-page .ak-top-narrative:hover .ak-top-label, .ak-products-page .ak-top-narrative:focus-visible .ak-top-label, .ak-products-page .ak-top-narrative:active .ak-top-label, .ak-products-page .ak-top-narrative.is-active .ak-top-label,
  .ak-products-page .ak-top-contact .ak-top-label, .ak-products-page .ak-top-contact:hover .ak-top-label, .ak-products-page .ak-top-contact:focus-visible .ak-top-label, .ak-products-page .ak-top-contact:active .ak-top-label, .ak-products-page .ak-top-contact.is-active .ak-top-label{
    color:transparent !important; text-shadow:none !important;
  }
  /* BAD / CANDY: tilt+scale on the inner graphic, anchor stays transform-stable (sizes BAD 1.18, CANDY 1.75) */
  .ak-products-page .ak-top-bad-mask{
    transform:scale(1.18) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    -webkit-transform:scale(1.18) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
  }
  .ak-products-page .ak-top-candy-img{
    transform:scale(1.75) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    -webkit-transform:scale(1.75) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
  }

  /* ============================================================
     FOOTER INTEGRATION — paper shows behind the footer, ink
     back-to-top. CTA text / id / aria-label / scroll behaviour are
     untouched (CSS only). ak-footer.liquid is NOT edited.
     ============================================================ */
  .ak-products-page .ak-footer{ background:transparent !important; }
  .ak-products-page .ak-btt{ color:#15120b !important; }                     /* .ak-btt-text inherits */
  .ak-products-page .ak-footer-copy{ color:rgba(21,18,11,.5) !important; }
  .ak-products-page .ak-btt:hover .ak-btt-text,
  .ak-products-page .ak-btt:focus-visible .ak-btt-text{ color:#ff33ff !important; } /* preserve purple hover/focus */
  .ak-products-page .ak-footer-rule{ background:none !important; }           /* remove footer glow line (keep spacing) */
</style>
