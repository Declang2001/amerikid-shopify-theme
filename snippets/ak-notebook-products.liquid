    --ak-products-label-font: 'Londrina Solid', Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
  }
  .ak-products-page .card-wrapper .card__heading,
  .ak-products-page .card-wrapper .card__heading a,
  .ak-products-page .card-wrapper .full-unstyled-link{
    font-family: var(--ak-products-label-font) !important;
  }

  /* ============================================================
     PRODUCT CUTOUT SHADOW v3 — open the real remaining clipping ancestor.
     v1 clipped because the filter lived on .media (overflow:hidden).
     v2 moved the filter to the img and opened .media, but Dawn's
     .card__media (component-card.css:77, .card .card__inner .card__media
     { overflow:hidden }) remained at the EXACT same 480x480 box and kept
     clipping the shadow identically — runtime ancestor audit confirmed it
     is the ONLY clipper between the img and <main>. Open both wrappers,
     page-scoped only (do NOT edit shared component-card.css; its
     overflow:hidden serves border-radius/hover-zoom, neither active here:
     radius 0, no zoom rule). The shadow stays on the transparent product
     img (canvas alpha-verified PNGs) so it follows the true silhouette.
     Pixel-diff verified: tray side shadows +8/+10, raglan bottom +27.
     Known asset limits (NOT CSS): the FreeVitaly hem and the combo's
     right side are cropped at the source-PNG edge, so their shadows end
     in a soft straight band — fixable only by re-exported PNGs.
     Ink-tinted double shadow = soft lift + tight contact shadow. The
     badge branch (.card__content .card__badge — NEW / sold-out) is a
     sibling of .media and is untouched. Revert: delete this block. */
  .ak-products-page .card__media,
  .ak-products-page .card__media .media{
    overflow:visible !important;
  }
  .ak-products-page .card__media img{
    filter: drop-shadow(0 14px 14px rgba(21,18,11,.24)) drop-shadow(0 3px 2px rgba(21,18,11,.18));
  }

  /* ============================================================
     HEADER / NAV / CART — FULL notebook parity, ported from the
     accepted .ak-lifestyle-page treatment (itself ported from the
     accepted Club Hub Phase 3.9 mask-PNG nav) and re-scoped to
     .ak-products-page. ak-top.liquid is NOT edited; routes/order,
     MENU drawer JS, and cart behaviour are unchanged. The five
