  .ak-products-page .loading-overlay__spinner .path{ stroke:#15120b; }

  /* ============================================================
     PHASE 6.2 FONT PROOF (TEMPORARY) — Londrina Solid on the
     Products grid product names ONLY (candidate 3 of the approved
     font-analysis shortlist; candidate 1 Permanent Marker = too close
