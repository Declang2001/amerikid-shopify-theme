<style>
  /* ============================================================
     PHASE 5.0 — PRODUCTS NOTEBOOK PAPER BACKDROP
     CSS-only, scoped entirely to .ak-products-page. Reuses the
     accepted Club Hub / Life/Style paper values; does not touch
     the grid section, cards, badges, or any markup.
     ============================================================ */
  .ak-products-page{
    --ak-paper-top-gap: clamp(150px, 17vw, 220px);    /* blank top band behind the KID logo */
    --ak-paper-bottom-gap: clamp(130px, 12vw, 190px); /* blank bottom band — ruled lines fade out so the page doesn't end mid-line */
  }
  .ak-products-page body{
    --ak-paper-side-gap: clamp(82px, 7vw, 128px);     /* shared inset for both vertical rules (red left + blue right) */
    background-color:#f5dd4f !important;              /* pale legal-pad yellow (beats the global html,body{background:#000} via higher specificity) */
    background-image:
      linear-gradient(90deg,
        transparent calc(100% - var(--ak-paper-side-gap)),
        rgba(44,120,180,.60) calc(100% - var(--ak-paper-side-gap)),
        rgba(44,120,180,.60) calc(100% - var(--ak-paper-side-gap) + 2px),
        transparent calc(100% - var(--ak-paper-side-gap) + 2px)),   /* blue RIGHT margin rule (2px, full height, scrolls with paper) */
      linear-gradient(90deg,
        transparent var(--ak-paper-side-gap),
        rgba(218,40,50,.74) var(--ak-paper-side-gap),
        rgba(218,40,50,.74) calc(var(--ak-paper-side-gap) + 2px),
        transparent calc(var(--ak-paper-side-gap) + 2px)),          /* red LEFT margin rule */
      linear-gradient(180deg,
        #f5dd4f 0,
        #f5dd4f var(--ak-paper-top-gap),
        transparent var(--ak-paper-top-gap)),                       /* blank yellow TOP band masks ruled lines in the top gap */
      linear-gradient(180deg,
        transparent calc(100% - var(--ak-paper-bottom-gap)),
        #f5dd4f calc(100% - var(--ak-paper-bottom-gap) + 36px)),     /* blank yellow BOTTOM band — ruled lines fade out into clean paper (no half-line at page bottom). Above the ruled lines, below the side rules. */
      repeating-linear-gradient(180deg,
        transparent 0 31px,
        rgba(44,120,180,.60) 31px 32px) !important;                 /* blue horizontal ruled lines */
    background-repeat:no-repeat, no-repeat, no-repeat, no-repeat, repeat !important;
    background-position:0 0, 0 0, 0 0, 0 0, 0 var(--ak-paper-top-gap) !important; /* ruled lines start at the top gap */
    background-attachment:scroll, scroll, scroll, scroll, scroll !important;      /* glued to content — scrolls with the page */
  }
  /* Let the body paper show through the page chrome. The grid section's own
     background:#000 !important is already beaten at runtime by the global
     #MainContent .gradient transparency net in layout/theme.liquid
     (DevTools-verified: the section wrapper computes rgba(0,0,0,0)) —
     these are page-scoped backstops only. */
  .ak-products-page #MainContent{ background:transparent !important; }
  .ak-products-page #MainContent .gradient{ background:transparent !important; background-image:none !important; }

  /* ============================================================
     PRODUCT CARD TITLES → INK ON PAPER (CSS-only)
     Titles are currently white Impact 3rem uppercase (set by the grid
     section, which is NOT edited) — invisible on yellow. Recolor only;
     sizing/layout/links/badges untouched. Hover/focus = AmeriKid
     purple #ff33ff (matches the nav wordmark behavior on paper).
     ============================================================ */
  .ak-products-page .card-wrapper .card__heading,
  .ak-products-page .card-wrapper .card__heading a,
  .ak-products-page .card-wrapper .card__information .full-unstyled-link{
    color:#15120b !important;
  }
  .ak-products-page .card-wrapper .card__heading a:hover,
  .ak-products-page .card-wrapper .card__heading a:focus-visible,
  .ak-products-page .card-wrapper:hover .card__information .full-unstyled-link{
    color:#ff33ff !important;
  }
  /* Dawn paints a focus/loading veil + skeletons in scheme colors on AJAX
