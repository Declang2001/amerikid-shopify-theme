  /* the five wordmark masks live on ::before (holds the static tilt; overrides base .ak-top-tile::before{display:none}) */
  .ak-products-page .ak-top-life::before,
  .ak-products-page .ak-top-products::before,
  .ak-products-page .ak-top-archive::before,
