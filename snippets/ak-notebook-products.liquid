     ============================================================ */
  /* header on paper + ink for the non-mask bits (MENU trigger, BAD currentColor) */
  .ak-products-page .ak-top-wrap{ background:transparent !important; }
  .ak-products-page .ak-top-wrap::after{ background:none !important; }
  .ak-products-page .ak-top-label{ color:#15120b !important; }
  .ak-products-page .ak-top-bad{ color:#15120b !important; }
  .ak-products-page .ak-top-mobile-trigger{ color:#15120b !important; text-shadow:none !important; }
  .ak-products-page .ak-top-label::before,
  .ak-products-page .ak-top-label::after{ opacity:0 !important; }
  .ak-products-page .ak-top-tile:hover .ak-top-label,
  .ak-products-page .ak-top-tile.is-active .ak-top-label,
  .ak-products-page .ak-top-bad:hover,
  .ak-products-page .ak-top-bad.is-active,
  .ak-products-page .ak-top-mobile-trigger:hover{ color:#ff33ff !important; }
  /* cart: black ink at rest, magenta glow on hover/focus; small right nudge so the blue right rule isn't crowded */
  .ak-products-page .ak-top-cart-container{ transform:translateX(clamp(4px, .6vw, 10px)) !important; }
  .ak-products-page .ak-top-cart-img{ filter:brightness(0) !important; }
  .ak-products-page .ak-top-cart-link:hover .ak-top-cart-img,
  .ak-products-page .ak-top-cart-link:focus-visible .ak-top-cart-img{
    filter:brightness(0) drop-shadow(0 0 6px #ff33ff) drop-shadow(0 0 12px rgba(255,51,255,.5)) !important;
  }
  /* tighten logo->nav spacing + remove the dark-theme glow divider */
  .ak-products-page .ak-top-divider{ display:none !important; }
  .ak-products-page .ak-top-nav-panel{ padding-top:clamp(2px,0.6vw,8px) !important; }
  .ak-products-page .ak-top-nav-area{ margin-top:clamp(-22px,-2.2vw,-8px) !important; }
  /* per-tile mask + size + tilt (same PNGs / sizes / tilts as the accepted Club Hub / Life/Style nav) */
  .ak-products-page .ak-top-life{    --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/lifestyle_button.png?v=1780886497"); --ak-nav-png-size:clamp(260px, 21vw, 400px);   --ak-nav-tilt:-2.2deg; }
  .ak-products-page .ak-top-products{--ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/products_button.png?v=1780886497");  --ak-nav-png-size:clamp(280px, 23vw, 430px);   --ak-nav-tilt:1.4deg; }
  .ak-products-page .ak-top-archive{ --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/archive_button.png?v=1780885375");   --ak-nav-png-size:clamp(270px, 22vw, 420px);   --ak-nav-tilt:-1.1deg; }
  .ak-products-page .ak-top-narrative{--ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/narrative_button.png?v=1780885375"); --ak-nav-png-size:clamp(265px, 21.5vw, 410px); --ak-nav-tilt:1.8deg; }
  .ak-products-page .ak-top-contact{ --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/moniker_button.png?v=1780885375");   --ak-nav-png-size:clamp(220px, 18vw, 340px);   --ak-nav-tilt:-1.6deg; }
  .ak-products-page .ak-top-bad{ --ak-nav-tilt:-2.5deg; }
  .ak-products-page .ak-top-candy{ --ak-nav-tilt:1.2deg; }
  /* clickable tiles (all 7): no transform / bg-png / recolor-filter; transform excluded from transitions */
  .ak-products-page .ak-top-life,
  .ak-products-page .ak-top-products,
  .ak-products-page .ak-top-archive,
  .ak-products-page .ak-top-narrative,
  .ak-products-page .ak-top-contact,
  .ak-products-page .ak-top-bad,
  .ak-products-page .ak-top-candy{
    transform:none !important; -webkit-transform:none !important;
    background-image:none !important; filter:none !important;
    transition-property:filter, color, opacity, background-color !important;
    will-change:auto !important;
  }
  /* the five wordmark masks live on ::before (holds the static tilt; overrides base .ak-top-tile::before{display:none}) */
  .ak-products-page .ak-top-life::before,
  .ak-products-page .ak-top-products::before,
  .ak-products-page .ak-top-archive::before,
  .ak-products-page .ak-top-narrative::before,
  .ak-products-page .ak-top-contact::before{
    content:"" !important; display:block !important; position:absolute !important;
    left:50% !important; top:50% !important;
    width:var(--ak-nav-png-size) !important; height:var(--ak-nav-png-size) !important;
    transform:translate(-50%, -50%) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    -webkit-transform:translate(-50%, -50%) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    transform-origin:center center !important;
    backface-visibility:hidden !important; -webkit-backface-visibility:hidden !important;
    pointer-events:none !important;
    background-color:#15120b !important;
    -webkit-mask:var(--ak-nav-mask) center / contain no-repeat !important;
    mask:var(--ak-nav-mask) center / contain no-repeat !important;
    transition:background-color .12s ease, opacity .12s ease !important;
    z-index:1 !important;
  }
  /* hover / keyboard-focus / press -> the WHOLE wordmark turns purple (.is-active EXCLUDED — it has its own rule) */
  .ak-products-page .ak-top-life:hover::before, .ak-products-page .ak-top-life:focus-visible::before, .ak-products-page .ak-top-life:active::before,
  .ak-products-page .ak-top-products:hover::before, .ak-products-page .ak-top-products:focus-visible::before, .ak-products-page .ak-top-products:active::before,
  .ak-products-page .ak-top-archive:hover::before, .ak-products-page .ak-top-archive:focus-visible::before, .ak-products-page .ak-top-archive:active::before,
  .ak-products-page .ak-top-narrative:hover::before, .ak-products-page .ak-top-narrative:focus-visible::before, .ak-products-page .ak-top-narrative:active::before,
  .ak-products-page .ak-top-contact:hover::before, .ak-products-page .ak-top-contact:focus-visible::before, .ak-products-page .ak-top-contact:active::before{
    background-color:#ff33ff !important;
  }
  /* ACTIVE / CURRENT-PAGE CUE — PRODUCTS on this route: purple wordmark +
