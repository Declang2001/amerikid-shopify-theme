  /* ============================================================
     FOOTER INTEGRATION — paper shows behind the footer, ink
     back-to-top, Due Date CTA. ak-footer.liquid is NOT edited.
     ============================================================ */
  .ak-badmusic-2025-page .ak-footer{ background:transparent !important; }
  .ak-badmusic-2025-page .ak-btt{ color:#15120b !important; }                     /* .ak-btt-text inherits */
