  }
  /* keep the five labels in the DOM for screen readers, but visually hidden in ALL states */
  .ak-badmusic-2025-page .ak-top-life .ak-top-label, .ak-badmusic-2025-page .ak-top-life:hover .ak-top-label, .ak-badmusic-2025-page .ak-top-life:focus-visible .ak-top-label, .ak-badmusic-2025-page .ak-top-life:active .ak-top-label, .ak-badmusic-2025-page .ak-top-life.is-active .ak-top-label,
  .ak-badmusic-2025-page .ak-top-products .ak-top-label, .ak-badmusic-2025-page .ak-top-products:hover .ak-top-label, .ak-badmusic-2025-page .ak-top-products:focus-visible .ak-top-label, .ak-badmusic-2025-page .ak-top-products:active .ak-top-label, .ak-badmusic-2025-page .ak-top-products.is-active .ak-top-label,
  .ak-badmusic-2025-page .ak-top-archive .ak-top-label, .ak-badmusic-2025-page .ak-top-archive:hover .ak-top-label, .ak-badmusic-2025-page .ak-top-archive:focus-visible .ak-top-label, .ak-badmusic-2025-page .ak-top-archive:active .ak-top-label, .ak-badmusic-2025-page .ak-top-archive.is-active .ak-top-label,
  .ak-badmusic-2025-page .ak-top-narrative .ak-top-label, .ak-badmusic-2025-page .ak-top-narrative:hover .ak-top-label, .ak-badmusic-2025-page .ak-top-narrative:focus-visible .ak-top-label, .ak-badmusic-2025-page .ak-top-narrative:active .ak-top-label, .ak-badmusic-2025-page .ak-top-narrative.is-active .ak-top-label,
