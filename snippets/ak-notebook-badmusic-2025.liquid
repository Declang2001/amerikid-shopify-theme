  .ak-badmusic-2025-page .ak-top-products{--ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/products_button.png?v=1780886497");  --ak-nav-png-size:clamp(280px, 23vw, 430px);   --ak-nav-tilt:1.4deg; }
  .ak-badmusic-2025-page .ak-top-archive{ --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/archive_button.png?v=1780885375");   --ak-nav-png-size:clamp(270px, 22vw, 420px);   --ak-nav-tilt:-1.1deg; }
  .ak-badmusic-2025-page .ak-top-narrative{--ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/narrative_button.png?v=1780885375"); --ak-nav-png-size:clamp(265px, 21.5vw, 410px); --ak-nav-tilt:1.8deg; }
  .ak-badmusic-2025-page .ak-top-contact{ --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/moniker_button.png?v=1780885375");   --ak-nav-png-size:clamp(220px, 18vw, 340px);   --ak-nav-tilt:-1.6deg; }
  .ak-badmusic-2025-page .ak-top-bad{ --ak-nav-tilt:-2.5deg; }
  .ak-badmusic-2025-page .ak-top-candy{ --ak-nav-tilt:1.2deg; }
  /* clickable tiles (all 7): no transform / bg-png / recolor-filter; transform excluded from transitions */
  .ak-badmusic-2025-page .ak-top-life,
  .ak-badmusic-2025-page .ak-top-products,
  .ak-badmusic-2025-page .ak-top-archive,
  .ak-badmusic-2025-page .ak-top-narrative,
  .ak-badmusic-2025-page .ak-top-contact,
  .ak-badmusic-2025-page .ak-top-bad,
  .ak-badmusic-2025-page .ak-top-candy{
    transform:none !important; -webkit-transform:none !important;
    background-image:none !important; filter:none !important;
    transition-property:filter, color, opacity, background-color !important;
    will-change:auto !important;
  }
  /* the five wordmark masks live on ::before (holds the static tilt; overrides base .ak-top-tile::before{display:none}) */
  .ak-badmusic-2025-page .ak-top-life::before,
  .ak-badmusic-2025-page .ak-top-products::before,
  .ak-badmusic-2025-page .ak-top-archive::before,
  .ak-badmusic-2025-page .ak-top-narrative::before,
  .ak-badmusic-2025-page .ak-top-contact::before{
    content:"" !important; display:block !important; position:absolute !important;
    left:50% !important; top:50% !important;
    width:var(--ak-nav-png-size) !important; height:var(--ak-nav-png-size) !important;
    transform:translate(-50%, -50%) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    -webkit-transform:translate(-50%, -50%) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    transform-origin:center center !important;
    backface-visibility:hidden !important; -webkit-backface-visibility:hidden !important;
    pointer-events:none !important;
    background-color:#15120b !important;
    -webkit-mask:var(--ak-nav-mask) center / contain no-repeat !important;
    mask:var(--ak-nav-mask) center / contain no-repeat !important;
    transition:background-color .12s ease, opacity .12s ease !important;
    z-index:1 !important;
  }
  /* hover / keyboard-focus / press -> the WHOLE wordmark turns purple */
  .ak-badmusic-2025-page .ak-top-life:hover::before, .ak-badmusic-2025-page .ak-top-life:focus-visible::before, .ak-badmusic-2025-page .ak-top-life:active::before,
  .ak-badmusic-2025-page .ak-top-products:hover::before, .ak-badmusic-2025-page .ak-top-products:focus-visible::before, .ak-badmusic-2025-page .ak-top-products:active::before,
  .ak-badmusic-2025-page .ak-top-archive:hover::before, .ak-badmusic-2025-page .ak-top-archive:focus-visible::before, .ak-badmusic-2025-page .ak-top-archive:active::before,
  .ak-badmusic-2025-page .ak-top-narrative:hover::before, .ak-badmusic-2025-page .ak-top-narrative:focus-visible::before, .ak-badmusic-2025-page .ak-top-narrative:active::before,
  .ak-badmusic-2025-page .ak-top-contact:hover::before, .ak-badmusic-2025-page .ak-top-contact:focus-visible::before, .ak-badmusic-2025-page .ak-top-contact:active::before{
