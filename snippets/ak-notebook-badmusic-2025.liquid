  .ak-badmusic-2025-page #MainContent .gradient{ background:transparent !important; background-image:none !important; }
  .ak-badmusic-2025-page .shopify-section{ background:transparent !important; }

  /* ============================================================
     FONTS — Due Date display voice (duplicated scoped @font-face,
     the deliberate house pattern; same self-hosted asset as the
     other notebook pages). No Tenada: there is no '#' on this page.
     ============================================================ */
