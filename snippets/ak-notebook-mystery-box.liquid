{%- comment -%} ND-2A — render shared notebook mobile-drawer font (font-only; page-class-scoped; ak-top.liquid untouched) {%- endcomment -%}
{% render 'ak-notebook-drawer' %}

<style>
  /* ============================================================
     STAGE MB-1 — MYSTERY BOX NOTEBOOK SHELL
     CSS-only, scoped to .ak-mysterybox-page. Paper + ink shell only;
     NO doodles, NO iframe/prestart/release/canvas/monitor edits.
     ============================================================ */

  /* ---- Notebook paper backdrop. Same accepted values as the other
     notebook pages (shared --ak-paper-side-gap). html.ak-mysterybox-page
     specificity is LOAD-BEARING: it must beat the global
     html,body{background:#000 !important} net in layout/theme.liquid. ---- */
  html.ak-mysterybox-page{
    --ak-paper-top-gap: clamp(150px, 17vw, 220px);    /* blank top band behind the KID logo / nav */
    --ak-paper-bottom-gap: clamp(130px, 12vw, 190px); /* blank bottom band — ruled lines fade out so the page doesn't end mid-line */
    --ak-purple:#ff33ff;                              /* official AmeriKid purple */
    background:#f5dd4f !important;                    /* overscroll/canvas fallback — beats the global html #000 via specificity */
  }
  html.ak-mysterybox-page body{
    --ak-paper-side-gap: clamp(82px, 7vw, 128px);     /* shared inset for both vertical rules (red left + blue right) */
    background-color:#f5dd4f !important;              /* pale legal-pad yellow */
    background-image:
      linear-gradient(90deg,
        transparent calc(100% - var(--ak-paper-side-gap)),
        rgba(44,120,180,.60) calc(100% - var(--ak-paper-side-gap)),
        rgba(44,120,180,.60) calc(100% - var(--ak-paper-side-gap) + 2px),
        transparent calc(100% - var(--ak-paper-side-gap) + 2px)),   /* blue RIGHT margin rule */
      linear-gradient(90deg,
        transparent var(--ak-paper-side-gap),
        rgba(218,40,50,.74) var(--ak-paper-side-gap),
        rgba(218,40,50,.74) calc(var(--ak-paper-side-gap) + 2px),
        transparent calc(var(--ak-paper-side-gap) + 2px)),          /* red LEFT margin rule */
      linear-gradient(180deg,
        #f5dd4f 0,
        #f5dd4f var(--ak-paper-top-gap),
        transparent var(--ak-paper-top-gap)),                       /* blank yellow TOP band */
      linear-gradient(180deg,
        transparent calc(100% - var(--ak-paper-bottom-gap)),
        #f5dd4f calc(100% - var(--ak-paper-bottom-gap) + 36px)),     /* blank yellow BOTTOM band */
      repeating-linear-gradient(180deg,
        transparent 0 31px,
        rgba(44,120,180,.60) 31px 32px) !important;                 /* blue horizontal ruled lines */
    background-repeat:no-repeat, no-repeat, no-repeat, no-repeat, repeat !important;
    background-position:0 0, 0 0, 0 0, 0 0, 0 var(--ak-paper-top-gap) !important;
    background-attachment:scroll, scroll, scroll, scroll, scroll !important;
  }

  /* ---- Transparency backstops — let the body paper show through the page
     chrome (without them the top reads as a black band, esp. on mobile).
     .gradient is scoped to #MainContent .gradient (NOT a bare .gradient) so it
     can never clobber the html.ak-mysterybox-page body paper paint. ---- */
  .ak-mysterybox-page #MainContent{ background:transparent !important; }
  .ak-mysterybox-page #MainContent .gradient{ background:transparent !important; background-image:none !important; }
  .ak-mysterybox-page .shopify-section{ background:transparent !important; }

  /* ---- THE ONE ROUTE-SPECIFIC PAINT: strip the embed wrapper's full-bleed
     #000 so the paper shows in the gutters around the centered dark monitor.
     `background` ONLY — height / min-height / width / margin-left / overflow /
     position / display / box-sizing / the JS-set inline embed.style.height and
     EVERY child (.ak-mb-frame / .ak-mb-iframe / .ak-mb-stage / .ak-mb-lock /
     .ak-mb-canvas) are NOT touched. The monitor stays its dark device. ---- */
  .ak-mysterybox-page #ak-mysterybox-embed.ak-mb-wrap{ background:transparent !important; }

  /* ============================================================
     STAGE MB-2 — OUTLINE FIX (2026-06-17)
     The pre-existing #ak-mysterybox-embed .ak-mb-stage::before carries a
     decorative "recessed-well seam" INSET shadow
     (box-shadow: inset 0 1px 2px rgba(0,0,0,.4), inset 0 0 1px rgba(0,0,0,.6))
     applied to the FULL-bleed stage (~1396x876 @1440) — invisible on the old
     #000 .ak-mb-wrap, but after MB-1 made the wrap transparent it reads as a
     faint larger/offset rectangle around the dark monitor on the yellow paper.
     Kill ONLY that inset shadow (PAINT-ONLY). The pseudo has content:"" but no
     background, so it goes fully invisible; inset:0 / pointer-events:none /
     z-index:3 stay untouched -> zero behavioural effect. The .ak-mb-frame hard
     1px ring (0 0 0 1px rgba(0,0,0,.95)) AND the wanted soft drop shadow are
     INTENTIONALLY LEFT as-is (NOT part of this pass; pending owner A/B).
     Revert: delete this STAGE MB-2 block.
     ============================================================ */
  .ak-mysterybox-page #ak-mysterybox-embed .ak-mb-stage::before{
    box-shadow:none !important;
  }

  /* ============================================================
     FONTS — Due Date display voice (duplicated scoped @font-face,
     the deliberate house pattern; same self-hosted asset as the
     other notebook pages). No Tenada: there is no '#' on this route.
     ============================================================ */
  @font-face{
    font-family: 'AK Due Date';
    src: url('{{ 'ak-due-date.woff2' | asset_url }}') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* ============================================================
     HEADER / NAV / CART — FULL notebook parity, ported from the
     accepted mask-PNG nav treatment and re-scoped to .ak-mysterybox-page.
     ak-top.liquid is NOT edited. CANDYFACTS (.ak-top-candy, href
     /pages/mystery-box) is the active tile here: it is an IMAGE tile, so its
     active state is the base candy-img magenta glow (left intact), not the
     masked-wordmark ::before cue.
     ============================================================ */
  .ak-mysterybox-page .ak-top-wrap{ background:transparent !important; }
  .ak-mysterybox-page .ak-top-wrap::after{ background:none !important; }
  .ak-mysterybox-page .ak-top-label{ color:#15120b !important; }
  .ak-mysterybox-page .ak-top-bad{ color:#15120b !important; }
  .ak-mysterybox-page .ak-top-mobile-trigger{ color:#15120b !important; text-shadow:none !important; }
  .ak-mysterybox-page .ak-top-label::before,
  .ak-mysterybox-page .ak-top-label::after{ opacity:0 !important; }
  .ak-mysterybox-page .ak-top-tile:hover .ak-top-label,
  .ak-mysterybox-page .ak-top-tile.is-active .ak-top-label,
  .ak-mysterybox-page .ak-top-bad:hover,
  .ak-mysterybox-page .ak-top-bad.is-active,
  .ak-mysterybox-page .ak-top-mobile-trigger:hover{ color:#ff33ff !important; }
  /* cart: black ink at rest, magenta glow on hover/focus; small right nudge so the blue right rule isn't crowded */
  .ak-mysterybox-page .ak-top-cart-container{ transform:translateX(clamp(4px, .6vw, 10px)) !important; }
  .ak-mysterybox-page .ak-top-cart-img{ filter:brightness(0) !important; }
  .ak-mysterybox-page .ak-top-cart-link:hover .ak-top-cart-img,
  .ak-mysterybox-page .ak-top-cart-link:focus-visible .ak-top-cart-img{
    filter:brightness(0) drop-shadow(0 0 6px #ff33ff) drop-shadow(0 0 12px rgba(255,51,255,.5)) !important;
  }
  /* tighten logo->nav spacing + remove the dark-theme glow divider */
  .ak-mysterybox-page .ak-top-divider{ display:none !important; }
  .ak-mysterybox-page .ak-top-nav-panel{ padding-top:clamp(2px,0.6vw,8px) !important; }
  .ak-mysterybox-page .ak-top-nav-area{ margin-top:clamp(-22px,-2.2vw,-8px) !important; }
  /* per-tile mask + size + tilt (same PNGs / sizes / tilts as the accepted notebook nav) */
  .ak-mysterybox-page .ak-top-life{    --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/lifestyle_button.png?v=1780886497"); --ak-nav-png-size:clamp(260px, 21vw, 400px);   --ak-nav-tilt:-2.2deg; }
  .ak-mysterybox-page .ak-top-products{--ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/products_button.png?v=1780886497");  --ak-nav-png-size:clamp(280px, 23vw, 430px);   --ak-nav-tilt:1.4deg; }
  .ak-mysterybox-page .ak-top-archive{ --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/archive_button.png?v=1780885375");   --ak-nav-png-size:clamp(270px, 22vw, 420px);   --ak-nav-tilt:-1.1deg; }
  .ak-mysterybox-page .ak-top-narrative{--ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/narrative_button.png?v=1780885375"); --ak-nav-png-size:clamp(265px, 21.5vw, 410px); --ak-nav-tilt:1.8deg; }
  .ak-mysterybox-page .ak-top-contact{ --ak-nav-mask:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/moniker_button.png?v=1780885375");   --ak-nav-png-size:clamp(220px, 18vw, 340px);   --ak-nav-tilt:-1.6deg; }
  .ak-mysterybox-page .ak-top-bad{ --ak-nav-tilt:-2.5deg; }
  .ak-mysterybox-page .ak-top-candy{ --ak-nav-tilt:1.2deg; }
  /* clickable tiles (all 7): no transform / bg-png / recolor-filter; transform excluded from transitions */
  .ak-mysterybox-page .ak-top-life,
  .ak-mysterybox-page .ak-top-products,
  .ak-mysterybox-page .ak-top-archive,
  .ak-mysterybox-page .ak-top-narrative,
  .ak-mysterybox-page .ak-top-contact,
  .ak-mysterybox-page .ak-top-bad,
  .ak-mysterybox-page .ak-top-candy{
    transform:none !important; -webkit-transform:none !important;
    background-image:none !important; filter:none !important;
    transition-property:filter, color, opacity, background-color !important;
    will-change:auto !important;
  }
  /* the five wordmark masks live on ::before (holds the static tilt; overrides base .ak-top-tile::before{display:none}) */
  .ak-mysterybox-page .ak-top-life::before,
  .ak-mysterybox-page .ak-top-products::before,
  .ak-mysterybox-page .ak-top-archive::before,
  .ak-mysterybox-page .ak-top-narrative::before,
  .ak-mysterybox-page .ak-top-contact::before{
    content:"" !important; display:block !important; position:absolute !important;
    left:50% !important; top:50% !important;
    width:var(--ak-nav-png-size) !important; height:var(--ak-nav-png-size) !important;
    transform:translate(-50%, -50%) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    -webkit-transform:translate(-50%, -50%) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    transform-origin:center center !important;
    backface-visibility:hidden !important; -webkit-backface-visibility:hidden !important;
    pointer-events:none !important;
    background-color:#15120b !important;
    -webkit-mask:var(--ak-nav-mask) center / contain no-repeat !important;
    mask:var(--ak-nav-mask) center / contain no-repeat !important;
    transition:background-color .12s ease, opacity .12s ease !important;
    z-index:1 !important;
  }
  /* hover / keyboard-focus / press -> the WHOLE wordmark turns purple (.is-active EXCLUDED — it has its own rule) */
  .ak-mysterybox-page .ak-top-life:hover::before, .ak-mysterybox-page .ak-top-life:focus-visible::before, .ak-mysterybox-page .ak-top-life:active::before,
  .ak-mysterybox-page .ak-top-products:hover::before, .ak-mysterybox-page .ak-top-products:focus-visible::before, .ak-mysterybox-page .ak-top-products:active::before,
  .ak-mysterybox-page .ak-top-archive:hover::before, .ak-mysterybox-page .ak-top-archive:focus-visible::before, .ak-mysterybox-page .ak-top-archive:active::before,
  .ak-mysterybox-page .ak-top-narrative:hover::before, .ak-mysterybox-page .ak-top-narrative:focus-visible::before, .ak-mysterybox-page .ak-top-narrative:active::before,
  .ak-mysterybox-page .ak-top-contact:hover::before, .ak-mysterybox-page .ak-top-contact:focus-visible::before, .ak-mysterybox-page .ak-top-contact:active::before{
    background-color:#ff33ff !important;
  }
  /* ACTIVE wordmark cue — fires for an active MASKED tile (parity with
