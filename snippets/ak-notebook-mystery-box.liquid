    -webkit-transform:scale(1.18) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
  }
  .ak-mysterybox-page .ak-top-candy-img{
    transform:scale(1.75) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
    -webkit-transform:scale(1.75) rotate(var(--ak-nav-tilt)) translateZ(0) !important;
  }

  /* ============================================================
     FOOTER INTEGRATION — paper shows behind the footer, ink
     back-to-top, Due Date CTA. ak-footer.liquid is NOT edited.
     ============================================================ */
  .ak-mysterybox-page .ak-footer{ background:transparent !important; }
  .ak-mysterybox-page .ak-btt{ color:#15120b !important; }                     /* .ak-btt-text inherits */
  .ak-mysterybox-page .ak-footer-copy{ color:rgba(21,18,11,.5) !important; }
  .ak-mysterybox-page .ak-btt:hover .ak-btt-text,
  .ak-mysterybox-page .ak-btt:focus-visible .ak-btt-text{ color:#ff33ff !important; } /* preserve purple hover/focus */
  .ak-mysterybox-page .ak-footer-rule{ background:none !important; }           /* remove footer glow line (keep spacing) */
  .ak-mysterybox-page .ak-btt-text{ font-family:'AK Due Date', Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif !important; }

  /* ============================================================
     STAGE MB-3B — COVER FONT PASS (2026-06-17)
     Font-family ONLY: move the glyph-safe Shopify-side prestart COVER
     display text (the .ak-mb-prestart overlay from sections/ak-mb-prestart.liquid,
