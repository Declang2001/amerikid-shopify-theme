     (an IMAGE tile with no ::before mask), so this rule is inert here; the
     candy active glow comes from the base .ak-top-candy.is-active .ak-top-candy-img. */
  .ak-mysterybox-page .ak-top-tile.is-active::before{
    background-color:#ff33ff !important;
    filter:
      drop-shadow(0 0 4px #ff33ff)
      drop-shadow(0 0 12px rgba(255,51,255,.75))
      drop-shadow(0 0 24px rgba(255,51,255,.5)) !important;
  }
  /* keep the five labels in the DOM for screen readers, but visually hidden in ALL states */
  .ak-mysterybox-page .ak-top-life .ak-top-label, .ak-mysterybox-page .ak-top-life:hover .ak-top-label, .ak-mysterybox-page .ak-top-life:focus-visible .ak-top-label, .ak-mysterybox-page .ak-top-life:active .ak-top-label, .ak-mysterybox-page .ak-top-life.is-active .ak-top-label,
  .ak-mysterybox-page .ak-top-products .ak-top-label, .ak-mysterybox-page .ak-top-products:hover .ak-top-label, .ak-mysterybox-page .ak-top-products:focus-visible .ak-top-label, .ak-mysterybox-page .ak-top-products:active .ak-top-label, .ak-mysterybox-page .ak-top-products.is-active .ak-top-label,
  .ak-mysterybox-page .ak-top-archive .ak-top-label, .ak-mysterybox-page .ak-top-archive:hover .ak-top-label, .ak-mysterybox-page .ak-top-archive:focus-visible .ak-top-label, .ak-mysterybox-page .ak-top-archive:active .ak-top-label, .ak-mysterybox-page .ak-top-archive.is-active .ak-top-label,
  .ak-mysterybox-page .ak-top-narrative .ak-top-label, .ak-mysterybox-page .ak-top-narrative:hover .ak-top-label, .ak-mysterybox-page .ak-top-narrative:focus-visible .ak-top-label, .ak-mysterybox-page .ak-top-narrative:active .ak-top-label, .ak-mysterybox-page .ak-top-narrative.is-active .ak-top-label,
  .ak-mysterybox-page .ak-top-contact .ak-top-label, .ak-mysterybox-page .ak-top-contact:hover .ak-top-label, .ak-mysterybox-page .ak-top-contact:focus-visible .ak-top-label, .ak-mysterybox-page .ak-top-contact:active .ak-top-label, .ak-mysterybox-page .ak-top-contact.is-active .ak-top-label{
    color:transparent !important; text-shadow:none !important;
  }
  /* BAD / CANDY: tilt+scale on the inner graphic, anchor stays transform-stable (sizes BAD 1.18, CANDY 1.75). The candy-img filter is NOT set here, so the base active magenta glow survives. */
  .ak-mysterybox-page .ak-top-bad-mask{
