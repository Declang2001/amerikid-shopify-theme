{% doc %}
  Strips the top chrome on drop pages: hides the AmeriKid logo and all seven nav
  tiles, keeps the fixed cart button.

  sections/ak-top.liquid is NOT edited. docs/known-fragile-areas.md:209 mandates
  restyling it "ONLY from page-scoped CSS (never edit sections/ak-top.liquid or
  its JS)", and every ak-notebook-* snippet header carries that same promise.

  Selectors verified against sections/ak-top.liquid:
    :312 a.header__heading-link  — the logo link
    :314 .ak-top-dock            — the logo dock inside it
    :340 .ak-top-nav-area        — wraps .ak-top-nav-panel (:342) and the
                                   7 tiles at :345-358 plus the drawer at :360-368
    :85  .ak-top-cart-container  — position:fixed, z-index:9999. KEPT.
  The drawer is relocated to a direct child of <body> by ak-top.liquid:481-483,
  so an html-rooted selector still reaches it.

  Also repoints every stray link to the OLD main collection at the drop wall.
  sections/main-cart-items.liquid:355 and :360 hardcode "Continue shopping" to
  /collections/master-collection, and ak-top.liquid:346/:363 do the same for the
  PRODUCTS tile. None of those files may be edited
  (docs/known-fragile-areas.md:209), so the repoint happens here, page-scoped.

  @param {string} [drop_url] - Where old-collection links should go instead.
                               Defaults to /collections/supreme-leader.
  @example
    {% render 'ak-drop-chrome', drop_url: '/collections/supreme-leader' %}
{% enddoc %}

{%- assign ak_drop_url = drop_url | default: '/collections/supreme-leader' -%}

{%- style -%}
  html.ak-drop-page a.header__heading-link,
  html.ak-drop-page .ak-top-dock,
  html.ak-drop-page .ak-top-nav-area,
  html.ak-drop-page .ak-top-drawer,
  html.ak-pdp-drop a.header__heading-link,
  html.ak-pdp-drop .ak-top-dock,
  html.ak-pdp-drop .ak-top-nav-area,
  html.ak-pdp-drop .ak-top-drawer,
  html.ak-cart-drop a.header__heading-link,
  html.ak-cart-drop .ak-top-dock,
  html.ak-cart-drop .ak-top-nav-area,
  html.ak-cart-drop .ak-top-drawer{
    display:none !important;
  }

  /* LOAD-BEARING: the leading `html` type selector is the ONLY reason these win.
     sections/ak-top.liquid:261 declares display:flex!important on
     .ak-top-drawer[data-ak-top-drawer] at (0,2,0). The rules above are (0,2,1).
     Rewriting them as `.ak-drop-page .ak-top-drawer` drops to (0,2,0), loses the
     tie on source order, and turns the drawer into a full-screen z-99999 overlay
     of seven notebook links. Do not "tidy" the html prefix away. */

  /* the Club AmeriKid launcher is rendered globally from layout/theme.liquid:427,
     so it appears on every drop surface and links out to /pages/club-hub and
     /account/register (club-amerikid-launcher.liquid:54,61) */
  html.ak-drop-page #club-amerikid-launcher,
  html.ak-pdp-drop #club-amerikid-launcher,
  html.ak-cart-drop #club-amerikid-launcher{
    display:none !important;
  }

  /* the cart bubble stays — it is position:fixed so it does not need the header */
  html.ak-drop-page .ak-top-cart-container,
  html.ak-pdp-drop .ak-top-cart-container,
  html.ak-cart-drop .ak-top-cart-container{
    display:block !important;
  }

  /* collapse the space the emptied header used to hold, so the banner and the
     wall start at the top of the page instead of below a blank band */
  html.ak-drop-page .ak-top-header,
  html.ak-pdp-drop .ak-top-header,
  html.ak-cart-drop .ak-top-header{
    min-height:0 !important;
    padding-top:0 !important;
    padding-bottom:0 !important;
  }
{%- endstyle -%}


<script>
  (function () {
    var DROP = {{ ak_drop_url | json }};
    var OLD  = '/collections/master-collection';

    function repoint(root) {
      var as = (root || document).querySelectorAll('a[href*="' + OLD + '"]');
      for (var i = 0; i < as.length; i++) {
        as[i].setAttribute('href', DROP);
      }
    }

    function boot() {
      repoint(document);

      /* Make the hidden notebook nav inert as well as invisible. The hiding CSS
         is emitted AFTER ak-top in the section order, so on a slow response its
         anchors are briefly parsed and clickable before display:none lands. */
      var dead = document.querySelectorAll('.ak-top-nav-area, .ak-top-drawer, #club-amerikid-launcher, a.header__heading-link');
      for (var j = 0; j < dead.length; j++) {
        dead[j].setAttribute('aria-hidden', 'true');
        try { dead[j].inert = true; } catch (e) {}
      }

      /* Cart quantity changes re-render sections via the Section Rendering API,
         which REPLACES DOM, so anchors repointed on load come back pointing at
         the old collection. Re-run on any subtree replacement, debounced. */
      if ('MutationObserver' in window) {
        var t = null;
        new MutationObserver(function () {
          clearTimeout(t);
          t = setTimeout(function () { repoint(document); }, 60);
        }).observe(document.body, { childList: true, subtree: true });
      }
    }

    /* Belt and braces: a delegated click catches any anchor inserted between a
       mutation and the debounce firing. */
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[href*="' + OLD + '"]') : null;
      if (!a) return;
      e.preventDefault();
      window.location.href = DROP;
    }, true);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>
