<option {% if top_size == 'XS' %}selected{% endif %}>XS</option>

<option {% if top_size == 'S' %}selected{% endif %}>S</option>

<option {% if top_size == 'M' %}selected{% endif %}>M</option>

<option {% if top_size == 'L' %}selected{% endif %}>L</option>

<option {% if top_size == 'XL' %}selected{% endif %}>XL</option>

<option {% if top_size == 'XXL' %}selected{% endif %}>XXL</option>

</select>

</div>

<div class="ak-field">

<label class="ak-label" for="ak-bottom">BOTTOM SIZE</label>

<select id="ak-bottom" class="ak-input" name="bottom_size">

<option value="" {% if bottom_size == blank %}selected{% endif %}>Select</option>

<option {% if bottom_size == '28' %}selected{% endif %}>28</option>

<option {% if bottom_size == '30' %}selected{% endif %}>30</option>

<option {% if bottom_size == '32' %}selected{% endif %}>32</option>

<option {% if bottom_size == '34' %}selected{% endif %}>34</option>

<option {% if bottom_size == '36' %}selected{% endif %}>36</option>

<option {% if bottom_size == '38' %}selected{% endif %}>38</option>

</select>

</div>

<div class="ak-field">

<label class="ak-label" for="ak-color">FAVORITE COLOR</label>

<input id="ak-color" class="ak-input" type="text" name="favorite_color"

value="{{ favorite_color | escape }}" placeholder="ex: purple / black / neon green" maxlength="24">

</div>

<div class="ak-field ak-span-2">

<label class="ak-label" for="ak-album">FAVORITE ALBUM</label>

<input id="ak-album" class="ak-input" type="text" name="favorite_album"

value="{{ favorite_album | escape }}" placeholder="ex: Bad Music Vol. 1" maxlength="40">

</div>

<div class="ak-field ak-span-2">

<label class="ak-label" for="ak-dream">DREAM AMERIKID PIECE (MAX 60)</label>

<textarea id="ak-dream" class="ak-input ak-textarea" name="dream_piece"

maxlength="60" rows="2"

placeholder="ex: a zombie-slayer hat with glow ink">{% if dream_piece %}{{ dream_piece | escape }}{% endif %}</textarea>

</div>

</div>

<div class="ak-form-footer">

<button class="ak-id-btn ak-primary" type="submit">

                    SAVE PROFILE

</button>

<div class="ak-save-note" id="ak-save-note">

                    Saved to your member profile.

</div>

</div>

</form>

</div>

</div>

<!-- Watermark seal — visible bottom-left of logged-in card -->

<div class="ak-card-seal" aria-hidden="true">
  <img
    src="https://cdn.shopify.com/s/files/1/0930/3267/7656/files/KID_SCRIBBLE_OUTLINE_6bd5ffa8-d310-4eb9-be67-23cf56737678.png?v=1747881692"
    alt=""
    loading="lazy"
    decoding="async"
  >
</div>

</div>

</div>

{% endif %}

</div>

</div>

<style>

/* IMPACT FONT: Force across entire Club Hub */
.ak-clubhub, .ak-clubhub *{
font-family: Impact, Haettenschweiler, "Arial Black", "Arial Narrow Bold", sans-serif !important;
  }

:root{

--ak-purple:#ff33ff;

--ak-cyan:#33ffff;

--ak-green:#33ff66;

--ak-black:#000;

--ak-paper:#f6f4ee;

--ak-ink:#121218;

  }

.ak-clubhub-page body,

.ak-clubhub-page #MainContent{

background:#000 !important;

  }

.ak-clubhub-page #MainContent .page-width{

max-width: none !important;

padding-left: 0 !important;

padding-right: 0 !important;

  }

/* ============================================================
   PHASE 1 — NOTEBOOK PAPER BACKDROP (Club Hub page only)
   CSS-only, scoped to .ak-clubhub-page. No DOM, no JS, no canvas.
   Paints pale legal-pad paper on <body> and clears the page-scoped
   black backdrops so it shows behind the existing dark panels.
   Text colors unchanged. Header/footer stay black (Phase 1).
   Revert: delete this block.
   ============================================================ */
.ak-clubhub-page{
  --ak-paper-top-gap: clamp(150px, 17vw, 220px);    /* blank title/header band before ruled lines (2.3: bigger) */
  --ak-paper-bottom-gap: clamp(130px, 12vw, 190px); /* 3.16: blank bottom margin band — ruled lines fade out here so the page doesn't end mid-line; the footer CTA sits on this clean paper */
}
.ak-clubhub-page body{
  --ak-paper-side-gap: clamp(82px, 7vw, 128px);         /* 3.11: shared inset for BOTH vertical rules (left red + right blue) so they sit evenly from each page edge */
  background-color:#f5dd4f !important;                 /* pale legal-pad yellow */
  background-image:
    linear-gradient(90deg,
      transparent calc(100% - var(--ak-paper-side-gap)),
      rgba(44,120,180,.60) calc(100% - var(--ak-paper-side-gap)),
      rgba(44,120,180,.60) calc(100% - var(--ak-paper-side-gap) + 2px),
      transparent calc(100% - var(--ak-paper-side-gap) + 2px)),  /* 3.10/3.11: blue RIGHT margin line (2px, full height, scrolls with paper, behind content) */
    linear-gradient(90deg,
      transparent var(--ak-paper-side-gap),
      rgba(218,40,50,.74) var(--ak-paper-side-gap),
      rgba(218,40,50,.74) calc(var(--ak-paper-side-gap) + 2px),
      transparent calc(var(--ak-paper-side-gap) + 2px)),  /* 1/3.11: left red margin line — now shares --ak-paper-side-gap (was fixed 56/58px) */
    linear-gradient(180deg,
      #f5dd4f 0,
      #f5dd4f var(--ak-paper-top-gap),
      transparent var(--ak-paper-top-gap)),             /* 2: blank yellow title band masks lines in the top gap */
    linear-gradient(180deg,
      transparent calc(100% - var(--ak-paper-bottom-gap)),
      #f5dd4f calc(100% - var(--ak-paper-bottom-gap) + 36px)),  /* 3.16: blank yellow BOTTOM margin band — ruled lines fade out into a clean footer paper area (no half-line at the page bottom). Sits ABOVE the ruled lines but BELOW the red/blue vertical rules, so the side rules still run full height like a real legal pad. */
    repeating-linear-gradient(180deg,
      transparent 0 31px,
      rgba(44,120,180,.60) 31px 32px) !important;       /* 3: blue/green ruled lines */
  background-repeat:no-repeat, no-repeat, no-repeat, no-repeat, repeat !important;
  background-position:0 0, 0 0, 0 0, 0 0, 0 var(--ak-paper-top-gap) !important; /* ruled lines start at the top gap */
  background-attachment:scroll, scroll, scroll, scroll, scroll !important; /* 2.2: glued to content — scrolls with the page */
}
/* Clear the page-scoped opaque blacks so the body paper shows through */
.ak-clubhub-page #MainContent{ background:transparent !important; }
.ak-clubhub-page .ak-clubhub{ background:transparent !important; }

/* ============================================================
   PHASE 3.15 — DECORATIVE DOODLE LAYER V4 (Club Hub page only)
   CSS-only + a tiny decorative DOM wrapper (8 aria-hidden <span>s,
   inserted just before .ak-clubhub in this snippet). Replaces the V3
   body::before multi-background layer so EACH doodle can be rotated
   individually (CSS background layers cannot be rotated per-layer).
   Composition: intentional loose diagonal rhythm — a few in the open
   header paper ABOVE the nav (never on nav/logo/cart), the rest spread
   down the lower open paper + footer-adjacent area (never on the card,
   the CLICK-HERE CTA, or the copyright). Full opacity; mix-blend-mode:
   multiply soaks the black ink into the yellow paper; page-anchored
   (absolute inside the page-anchored #MainContent, so it scrolls WITH
   the paper, not viewport-fixed); behind content (wrapper z-index:0;
   #MainContent z-index:1 + .ak-footer z-index:1 keep real content on top;
   ak-top owns z-index:999); pointer-events:none; hidden on mobile.
   Declan's transparent black-ink PNGs (1447x1385). Each item is placed +
   rotated individually below.
   Revert: delete this CSS block, the <div class="ak-clubhub-doodles">
   markup before .ak-clubhub, and the two z-index:1 content-lift rules. */
.ak-clubhub-page body{ position:relative; }                    /* page-anchor backstop */
.ak-clubhub-page #MainContent{ position:relative; z-index:1; } /* doodle-wrapper anchor + keeps content above the doodles */
.ak-clubhub-page .ak-footer{ position:relative; z-index:1; }   /* footer paints above the doodle layer */

.ak-clubhub-page .ak-clubhub-doodles{
  position:absolute; inset:0;
  z-index:0;
  pointer-events:none;
  mix-blend-mode:multiply;          /* transparent black ink soaks into the paper */
}
.ak-clubhub-page .ak-clubhub-doodle{
  position:absolute;
  display:block;
  background-repeat:no-repeat;
  background-position:center;
  background-size:contain;
  aspect-ratio:1447 / 1385;
  opacity:1;
  pointer-events:none;
  transform-origin:center center;
}
/* individual placement + rotation — loose diagonal rhythm, not a grid */
.ak-clubhub-page .ak-clubhub-doodle--dice{    /* hero — upper-left open paper, above the nav */
  left:clamp(112px, 8vw, 165px); top:36px; width:clamp(210px, 14vw, 230px);
  transform:rotate(-8deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-dice.png?v=1780967556");
}
.ak-clubhub-page .ak-clubhub-doodle--money{   /* upper-right open paper, above the nav, left of the cart.
                                                  Phase 3.16: this slot INTENTIONALLY uses the DOLLAR asset
                                                  (money/diamond replaced per Declan) — Club Hub reuses the
                                                  dollar doodle twice on purpose; class name kept to minimise churn. */
  right:clamp(125px, 9vw, 190px); top:54px; width:clamp(175px, 13vw, 250px);
  transform:rotate(9deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-dollar.png?v=1780967556");
}
.ak-clubhub-page .ak-clubhub-doodle--hashtag{ /* near the KID logo zone, above the nav (not on the logo) */
  left:clamp(410px, 32vw, 560px); top:98px; width:clamp(135px, 10vw, 190px);
  transform:rotate(-5deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-hashtag.png?v=1780967556");
}
.ak-clubhub-page .ak-clubhub-doodle--kid{     /* lower-left open paper, below the member card */
  left:clamp(150px, 10vw, 220px); top:990px; width:clamp(210px, 15vw, 290px);
  transform:rotate(-10deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-kid.png?v=1780967556");
}
.ak-clubhub-page .ak-clubhub-doodle--eyes{    /* lower centre-right, peeking into the open paper */
  right:clamp(380px, 28vw, 540px); top:1055px; width:clamp(155px, 11vw, 230px);
  transform:rotate(7deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-eyes.png?v=1780967556");
}
.ak-clubhub-page .ak-clubhub-doodle--dollar{  /* lower-middle, offset from KID/eyes */
  left:clamp(600px, 46vw, 760px); top:1140px; width:clamp(150px, 11vw, 220px);
  transform:rotate(4deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-dollar.png?v=1780967556");
}
.ak-clubhub-page .ak-clubhub-doodle--star{    /* smaller rhythm mark, lower-right / footer side */
  right:clamp(120px, 9vw, 200px); top:1230px; width:clamp(165px, 12vw, 235px);
  transform:rotate(-13deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-star.png?v=1780967556");
}
.ak-clubhub-page .ak-clubhub-doodle--cross{   /* footer-adjacent, left of the CTA (not on it) */
  left:clamp(330px, 24vw, 460px); top:1305px; width:clamp(145px, 10vw, 210px);
  transform:rotate(11deg);
  background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-cross.png?v=1780967556");
}
/* Phase 3.18 — SIDE-MARGIN DOODLES: two small marks in the outer paper
   strips (OUTSIDE the red/blue vertical rules), echoing the Life/Style
   side-margin presence. Duplicate assets (eyes/cross already appear in
   the lower open paper) are differentiated by placement, size, and
   rotation per the duplicate-doodle rule; neither is a header-cluster
   asset, so the top of the page does not read duplicated. Gated to
   >=1200px: below that the outer strip (--ak-paper-side-gap, ~82px)
   is too tight for the rotated bounding box to stay clear of the
   vertical rules. Base treatment (multiply blend, pointer-events:none,
   aspect-ratio, wrapper z-index:0, <=768px wrapper hide) is inherited.
   Revert: delete this block + the two --mgn spans in the wrapper. */
.ak-clubhub-page .ak-clubhub-doodle--mgn-left,
.ak-clubhub-page .ak-clubhub-doodle--mgn-right{ display:none; }
@media (min-width:1200px){
  .ak-clubhub-page .ak-clubhub-doodle--mgn-left{   /* LEFT outer strip — beside the member card, left of the red rule */
    display:block;
    left:clamp(5px, 0.5vw, 9px); top:640px; width:clamp(64px, 5.8vw, 90px);
    transform:rotate(-6deg);
    background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-eyes.png?v=1780967556");
  }
  .ak-clubhub-page .ak-clubhub-doodle--mgn-right{  /* RIGHT outer strip — right of the blue rule, beside the lower
                                                       member card. top:845px keeps it clear of the FIXED cart's
                                                       viewport slot at every scroll position on a 900px-tall
                                                       window (cart floats at viewport y~11-108; max scroll ~707,
                                                       so the slot never reaches abs y 845). */
    display:block;
    right:clamp(5px, 0.5vw, 9px); top:845px; width:clamp(64px, 5.8vw, 90px);
    transform:rotate(7deg);
    background-image:url("https://cdn.shopify.com/s/files/1/0930/3267/7656/files/ak-doodle-cross.png?v=1780967556");
  }
}
/* hide the doodle layer on mobile so it never crowds the narrow content column */
@media (max-width:768px){ .ak-clubhub-page .ak-clubhub-doodles{ display:none !important; } }

/* ============================================================
   PHASE 2 — INK ON PAPER (Club Hub page only)
   CSS-only, scoped to .ak-clubhub-page. No DOM, no JS, no canvas.
   Header/nav sits on the paper with black-ink labels (purple
   #ff33ff hover/active preserved); member-card text reads as dark
   ink on a light paper card; magenta/purple accents kept.
   Does NOT edit ak-top.liquid / ak-footer.liquid, footer, or any
   form/captcha/upload behavior. Form inputs deferred (Phase 2b).
   Revert: delete this block.
   ============================================================ */

/* --- Part 1: header/nav on paper (Club Hub only) --- */
.ak-clubhub-page .ak-top-wrap{ background:transparent !important; }
.ak-clubhub-page .ak-top-wrap::after{ background:none !important; }
.ak-clubhub-page .ak-top-label{ color:#15120b !important; }       /* ink at rest */
.ak-clubhub-page .ak-top-bad{ color:#15120b !important; }         /* BAD mask uses currentColor */
.ak-clubhub-page .ak-top-mobile-trigger{ color:#15120b !important; text-shadow:none !important; } /* MENU ink, flat */
.ak-clubhub-page .ak-top-label::before,
.ak-clubhub-page .ak-top-label::after{ opacity:0 !important; }    /* damp white glint sheen */
.ak-clubhub-page .ak-top-tile:hover .ak-top-label,
.ak-clubhub-page .ak-top-tile.is-active .ak-top-label,
.ak-clubhub-page .ak-top-bad:hover,
.ak-clubhub-page .ak-top-bad.is-active,
.ak-clubhub-page .ak-top-mobile-trigger:hover{ color:#ff33ff !important; } /* preserve purple hover/active */
/* cart button: black ink at rest, magenta glow on hover/focus (Club Hub only; img is a light PNG → filter) */
/* 3.11: nudge the cart slightly right (Club Hub only) so the blue right rule isn't crowded by it
   (DevTools measured a 2px gap at 1440 -> ~10px after nudge). transform-only on the fixed cart
   wrapper, no layout shift; cart stays visible/clickable and the bob/tilt animations are unaffected. */
.ak-clubhub-page .ak-top-cart-container{ transform:translateX(clamp(4px, .6vw, 10px)) !important; }
.ak-clubhub-page .ak-top-cart-img{ filter:brightness(0) !important; }
.ak-clubhub-page .ak-top-cart-link:hover .ak-top-cart-img,
.ak-clubhub-page .ak-top-cart-link:focus-visible .ak-top-cart-img{
  filter:brightness(0) drop-shadow(0 0 6px #ff33ff) drop-shadow(0 0 12px rgba(255,51,255,.5)) !important;
}

/* --- Part 2: member-card ink on paper (Club Hub only) --- */
.ak-clubhub-page .ak-id-card{
  background:linear-gradient(180deg, rgba(255,236,100,.92), rgba(245,221,79,.88)) !important;
  -webkit-backdrop-filter:none !important;
  backdrop-filter:none !important;                                 /* magenta border/glow kept from base */
}
.ak-clubhub-page .ak-id-title,
.ak-clubhub-page .ak-id-sub,
.ak-clubhub-page .ak-label,
.ak-clubhub-page .ak-value,
.ak-clubhub-page .ak-id-hint,
.ak-clubhub-page .ak-id-photo-mark,
.ak-clubhub-page .ak-id-photo-note,
.ak-clubhub-page .ak-mini-label,
.ak-clubhub-page .ak-mini-value,
.ak-clubhub-page .ak-id-section-title{ color:#15120b !important; } /* dark ink, specific selectors only */
.ak-clubhub-page .ak-id-fields{ background:rgba(0,0,0,.05) !important; }     /* light inset so ink reads */
.ak-clubhub-page .ak-id-photo-frame{ background:rgba(0,0,0,.06) !important; }
.ak-clubhub-page .ak-id-btn{ background:#15120b !important; }      /* solid dark btn; white label + magenta accent kept */
.ak-clubhub-page .ak-id-btn:hover{ background:#241f14 !important; } /* preserve hover lighten */

/* --- Part 3 (Phase 2.2): footer on paper (Club Hub only; no ak-footer.liquid edit) --- */
.ak-clubhub-page .ak-footer{ background:transparent !important; }                  /* paper shows behind footer */
.ak-clubhub-page .ak-btt{ color:#15120b !important; }                             /* back-to-top ink at rest (.ak-btt-text inherits) */
.ak-clubhub-page .ak-footer-copy{ color:rgba(21,18,11,.5) !important; }           /* muted ink copyright */
.ak-clubhub-page .ak-btt:hover .ak-btt-text,
.ak-clubhub-page .ak-btt:focus-visible .ak-btt-text{ color:#ff33ff !important; }  /* preserve purple hover/focus */
/* STAGE 2 FOOTER FONT (2026-06-12): the CTA adopts the Due Date secondary
   font, extending the approved Products Stage 1 treatment. The @font-face is
   duplicated here on purpose — each notebook page's system stays
   self-contained in its own snippet (house pattern), and the shared
   ak-footer.liquid stays un-edited. Same assets/ak-due-date.woff2 (FFC
   license, see the Products snippet for the full ledger); no Tenada (no '#'
   in the footer text). Size/tracking untouched (one-line at 375/320 verified
   at runtime). Dark/non-notebook routes keep Impact; a global footer font
   change stays rejected/deferred unless explicitly approved.
   Revert: delete this @font-face + the .ak-btt-text rule. */
@font-face{
  font-family: 'AK Due Date';
  src: url('{{ 'ak-due-date.woff2' | asset_url }}') format('woff2');
