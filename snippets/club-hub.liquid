ctx.shadowBlur = 0;

ctx.shadowColor = "transparent";

animationId = requestAnimationFrame(step);

  }

/* initial seed */

hardSeedOnce();

animationId = requestAnimationFrame(step);

/* resize listeners now do SOFT resize, not reseed */

window.addEventListener('resize', requestSoftResize, { passive:true });

if(window.visualViewport){

window.visualViewport.addEventListener('resize', requestSoftResize, { passive:true });

  }

if('ResizeObserver' in window){

var ro = new ResizeObserver(function(){ requestSoftResize(); });

ro.observe(root);

  }

if('IntersectionObserver' in window){

var io = new IntersectionObserver(function(entries){

entries.forEach(function(entry){

